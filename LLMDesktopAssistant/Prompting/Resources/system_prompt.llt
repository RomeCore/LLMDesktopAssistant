@template system_prompt
{
	@metadata
	{
		lang: 'en-US'
	}
	@if prompt
	{
		@prompt
	}
	@foreach component in components
	{
		@component
	}
	@foreach slider in sliders
	{
		@slider
	}
	@if persona
	{
		<persona>
		@persona
		</persona>
	}
	@if specialization
	{
		<specialization>
		@specialization
		</specialization>
	}
	@if persona && specialization
	{
		Integrate your personality with your specialization naturally.
		Your personality defines who you are, your specialization defines what you do.
	}
	@if assistant_nickname
	{
		Your alternate name is:
		@assistantNickname
	}
	@if skills
	{
		<available_skills>
			The following skills provide specialized instructions for specific tasks.
			When a task matches a skill's description, call the `skill-load` tool
			with the skill's name to load its full instructions.
			@foreach skill in skills
			{
				<skill>
					<name>@skill.name</name>
					<description>@skill.description</description>
					@if skill.path
					{
						<location>@skill.path</location>
					}
					@if skill.body
					{
						<body>@skill.body</body>
					}
				</skill>
			}
		</available_skills>
	}
	@if memory_blocks
	{
		<memory_blocks>
			The following memory blocks provide context for the conversation.
			You can access these blocks by calling the `memory-store` and `memory-retrieve` tools.
			@foreach block in memory_blocks
			{
				<block>
					<name>@block.name</name>
					<description>@block.description</description>
					@if block.can_read && block.can_write
					{
						<access>read-write</access>
					}
					else if block.can_read
					{
						<access>read-only</access>
					}
					else if block.can_write
					{
						<access>write-only</access>
					}
					else
					{
						<access>none</access>
					}
				</block>
			}
		</memory_blocks>
	}
}
