<UserControl xmlns="https://github.com/avaloniaui"
						 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
						 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
						 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
						 xmlns:local="using:LLMDesktopAssistant.Agents.Tasks.MVVM"
						 xmlns:ico="using:Material.Icons.Avalonia"
						 xmlns:ctrl="using:LLMDesktopAssistant.Controls"
						 mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="100"
						 x:Class="LLMDesktopAssistant.Agents.Tasks.MVVM.AgentTaskView"
						 x:DataType="local:AgentTaskViewModel">

	<Border Padding="10,6" CornerRadius="6"
					Margin="0,2" MaxWidth="400"
					Background="{Binding StatusBackground}">

		<StackPanel>

			<Grid ColumnDefinitions="Auto,*,Auto">

				<!-- Status indicator: ProgressRing when running, icon otherwise -->
				<Panel Width="20" Height="20"
							 Margin="0,0,10,0"
							 VerticalAlignment="Center"
							 Grid.Column="0">

					<ctrl:ProgressRing IsVisible="{Binding IsRunning}"
														 IsIndeterminate="True"
														 Width="20" Height="20"
														 StrokeThickness="3"
														 Foreground="{DynamicResource PrimaryAccentBrush}"/>

					<ico:MaterialIcon Kind="{Binding StatusIcon}"
														Width="20" Height="20"
														IsVisible="{Binding IsRunning, Converter={StaticResource InverseBooleanConverter}}"/>

				</Panel>

				<!-- Main content -->
				<StackPanel VerticalAlignment="Center"
										Grid.Column="1">

					<!-- Task name -->
					<TextBlock Text="{Binding TaskName, TargetNullValue='(unnamed task)'}"
										 FontSize="13" FontWeight="Medium"
										 TextTrimming="CharacterEllipsis"
										 MaxLines="1"/>

					<!-- Status text -->
					<TextBlock Text="{Binding StatusText}"
										 FontSize="11"
										 Opacity="0.6"
										 Margin="0,2,0,0"/>

					<!-- Last content preview -->
					<TextBlock Text="{Binding LastContent}"
										 FontSize="11"
										 Opacity="0.65"
										 TextTrimming="CharacterEllipsis"
										 MaxLines="1"
										 IsVisible="{Binding LastContent, Converter={StaticResource StringNonEmptyToBooleanConverter}}"/>

				</StackPanel>

				<!-- Right side: summary + cancel + expand -->
				<StackPanel Orientation="Horizontal"
										VerticalAlignment="Center"
										Spacing="6"
										Grid.Column="2">

					<TextBlock Text="{Binding Summary}"
										 FontSize="11"
										 Opacity="0.55"
										 VerticalAlignment="Center"/>

					<Button Classes="SmallIconButton"
									Command="{Binding CancelCommand}"
									IsVisible="{Binding IsRunning}"
									ToolTip.Tip="Cancel task">
							<ico:MaterialIcon Kind="Stop" Width="14" Height="14"/>
					</Button>

					<ToggleButton IsChecked="{Binding IsExpanded, Mode=TwoWay}"
												IsVisible="{Binding HasSubTasks}"
												Classes="SmallIconButton"
												ToolTip.Tip="Toggle sub-tasks">
							<ico:MaterialIcon Kind="ChevronDown" Width="14" Height="14"/>
					</ToggleButton>

				</StackPanel>

			</Grid>

			<!-- Sub-tasks (recursive) -->
			<ItemsControl ItemsSource="{Binding SubTaskViewModels}"
										IsVisible="{Binding IsExpanded}">
				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<ContentControl Content="{Binding}" Margin="20,0,0,0"/>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>

		</StackPanel>

	</Border>

</UserControl>
