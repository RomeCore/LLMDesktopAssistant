<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 xmlns:local="using:LLMDesktopAssistant.LLM.MVVM.Settings"
			 xmlns:messages="using:LLMDesktopAssistant.LLM.Messages"
			 xmlns:loc="using:LLMDesktopAssistant.Localization"
			 xmlns:ico="using:Material.Icons.Avalonia"
			 x:Class="LLMDesktopAssistant.LLM.MVVM.Settings.ChatSkillsSettingsView"
			 x:DataType="local:ChatSkillsSettingsViewModel"
			 x:Name="VMRoot">

	<StackPanel Margin="8" Spacing="8">

		<!-- Enable skills checkbox -->
		<CheckBox IsChecked="{Binding SkillSettings.EnableSkills}"
				  Content="{loc:Loc settings-skills_enable}"/>

		<!-- Separator -->
		<Rectangle Height="1"
				   Fill="{DynamicResource DefaultForeground}"
				   Opacity="0.2"
				   Margin="0,10"/>

		<!-- ============================================================ -->
		<!-- AVAILABLE SKILLS -->
		<!-- ============================================================ -->
		<Grid ColumnDefinitions="*,Auto">
			<TextBlock Grid.Column="0"
					   Text="{loc:Loc settings-skills_available}"
					   FontSize="{DynamicResource FontSizeL}"
					   FontWeight="Bold"
					   VerticalAlignment="Center"/>

			<Button Grid.Column="1"
					Command="{Binding RefreshSkillsCommand}"
					Classes="IconButton"
					ToolTip.Tip="{loc:Loc settings-skills_refresh}">
				<ico:MaterialIcon Kind="Refresh"/>
			</Button>
		</Grid>

		<TextBlock Text="{loc:Loc settings-skills_available_hint}"
				   Opacity="0.6"
				   TextWrapping="Wrap"/>

		<ItemsControl ItemsSource="{Binding AvailableSkills}"
					  IsEnabled="{Binding SkillSettings.EnableSkills}">
			<ItemsControl.ItemTemplate>
				<DataTemplate x:DataType="local:SkillInfoItemViewModel">
					<Border BorderBrush="{DynamicResource SecondaryAccentBrush}"
							BorderThickness="1"
							CornerRadius="4"
							Padding="8"
							Margin="0,0,0,8">
						<Grid RowDefinitions="Auto,Auto,Auto,Auto" VerticalAlignment="Center">

							<!-- Row 0: Name + Enabled indicator -->
							<Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">

								<ico:MaterialIcon Grid.Column="0"
												  Kind="Cards"
												  Foreground="{DynamicResource PrimaryAccentBrush}"
												  Width="20" Height="20"
												  VerticalAlignment="Center"
												  Margin="0,0,8,0"/>

								<TextBlock Grid.Column="1"
										   Text="{Binding Name}"
										   FontWeight="Bold"
										   VerticalAlignment="Center"/>

								<ico:MaterialIcon Grid.Column="2"
												  Kind="Check"
												  Width="16" Height="16"
												  Foreground="{DynamicResource PrimaryAccentBrush}"
												  VerticalAlignment="Center"
												  IsVisible="{Binding Enabled}"/>
							</Grid>

							<!-- Row 1: Description -->
							<TextBlock Grid.Row="1"
									   Text="{Binding Description}"
									   Opacity="0.7"
									   FontSize="12"
									   TextWrapping="Wrap"
									   Margin="28,4,0,0"
									   IsVisible="{Binding Description, Converter={StaticResource StringNonEmptyToBooleanConverter}}"/>

							<!-- Row 2: Diagnostic flags -->
							<StackPanel Grid.Row="2"
										Orientation="Horizontal"
										Spacing="4"
										Margin="28,4,0,0"
										IsVisible="{Binding DiagnosticFlags.Count}">
								<ItemsControl ItemsSource="{Binding DiagnosticFlags}"
											  VerticalAlignment="Center">
									<ItemsControl.ItemsPanel>
										<ItemsPanelTemplate>
											<StackPanel Spacing="2" Orientation="Horizontal"/>
										</ItemsPanelTemplate>
									</ItemsControl.ItemsPanel>
									<ItemsControl.ItemTemplate>
										<DataTemplate x:DataType="messages:SkillDiagnosticFlagInfo">
											<Panel ToolTip.Tip="{Binding Description}">
												<ico:MaterialIcon Kind="{Binding Icon}"
																  Foreground="{Binding Color}"
																  Background="Transparent"
																  Width="14" Height="14"/>
											</Panel>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
								<TextBlock Text="—"
										   Opacity="0.4"
										   VerticalAlignment="Center"/>
								<TextBlock Text="{Binding DiagnosticFlags[0].DisplayName}"
										   Opacity="0.5"
										   FontSize="11"
										   VerticalAlignment="Center"
										   TextTrimming="CharacterEllipsis"/>
							</StackPanel>

							<!-- Row 3: Path -->
							<TextBlock Grid.Row="3"
									   Text="{Binding Path}"
									   Opacity="0.4"
									   FontSize="11"
									   TextTrimming="CharacterEllipsis"
									   Margin="28,2,0,0"
									   IsVisible="{Binding Path, Converter={StaticResource StringNonEmptyToBooleanConverter}}"/>

						</Grid>
					</Border>
				</DataTemplate>
			</ItemsControl.ItemTemplate>
		</ItemsControl>

		<!-- Separator -->
		<Rectangle Height="1"
				   Fill="{DynamicResource DefaultForeground}"
				   Opacity="0.2"
				   Margin="0,10"/>

		<!-- ============================================================ -->
		<!-- FETCH FROM ALL WORKING DIRECTORIES -->
		<!-- ============================================================ -->
		<CheckBox IsChecked="{Binding SkillSettings.FetchFromAllWorkingDirectories}"
				  Content="{loc:Loc settings-skills_fetch_all}"
				  IsEnabled="{Binding SkillSettings.EnableSkills}"/>

		<!-- Separator -->
		<Rectangle Height="1"
				   Fill="{DynamicResource DefaultForeground}"
				   Opacity="0.2"
				   Margin="0,10"/>

		<!-- ============================================================ -->
		<!-- ADDITIONAL SKILL DIRECTORIES -->
		<!-- ============================================================ -->
		<Grid ColumnDefinitions="*,Auto">
			<TextBlock Grid.Column="0"
					   Text="{loc:Loc settings-skills_additional_dirs}"
					   FontSize="{DynamicResource FontSizeL}"
					   FontWeight="Bold"
					   VerticalAlignment="Center"
					   IsEnabled="{Binding SkillSettings.EnableSkills}"/>

			<Button Grid.Column="1"
					Command="{Binding AddDirectoryCommand}"
					Classes="IconButton"
					ToolTip.Tip="{loc:Loc add}"
					IsEnabled="{Binding SkillSettings.EnableSkills}">
				<ico:MaterialIcon Kind="Plus"/>
			</Button>
		</Grid>

		<TextBlock Text="{loc:Loc settings-skills_additional_dirs_hint}"
				   Opacity="0.6"
				   TextWrapping="Wrap"/>

		<ItemsControl ItemsSource="{Binding SkillSettings.AdditionalSkillDirectories}"
					  IsEnabled="{Binding SkillSettings.EnableSkills}">
			<ItemsControl.ItemTemplate>
				<DataTemplate x:DataType="x:String">
					<Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,2">
						<TextBox Grid.Column="0"
								 Text="{Binding Mode=TwoWay}"
								 PlaceholderText="{loc:Loc settings-skills_dir_placeholder}"
								 VerticalContentAlignment="Center"/>

						<Button Grid.Column="1"
								Command="{Binding #VMRoot.DataContext.BrowseDirectoryCommand}"
								CommandParameter="{Binding}"
								Classes="IconButton"
								Margin="4,0,0,0"
								ToolTip.Tip="{loc:Loc env_browse}">
							<ico:MaterialIcon Kind="FolderOpen"/>
						</Button>

						<Button Grid.Column="2"
								Command="{Binding #VMRoot.DataContext.OpenPathCommand}"
								CommandParameter="{Binding}"
								Classes="IconButton"
								Margin="2,0"
								ToolTip.Tip="{loc:Loc env_open_in_explorer}">
							<ico:MaterialIcon Kind="OpenInNew"/>
						</Button>

						<Button Grid.Column="3"
								Command="{Binding #VMRoot.DataContext.RemoveDirectoryCommand}"
								CommandParameter="{Binding}"
								Classes="IconButton"
								Margin="2,0,0,0">
							<ico:MaterialIcon Kind="Close"/>
						</Button>
					</Grid>
				</DataTemplate>
			</ItemsControl.ItemTemplate>
		</ItemsControl>

		<!-- Separator -->
		<Rectangle Height="1"
				   Fill="{DynamicResource DefaultForeground}"
				   Opacity="0.2"
				   Margin="0,10"/>

		<!-- ============================================================ -->
		<!-- ADDITIONAL SKILL FILES -->
		<!-- ============================================================ -->
		<Grid ColumnDefinitions="*,Auto">
			<TextBlock Grid.Column="0"
					   Text="{loc:Loc settings-skills_additional_files}"
					   FontSize="{DynamicResource FontSizeL}"
					   FontWeight="Bold"
					   VerticalAlignment="Center"
					   IsEnabled="{Binding SkillSettings.EnableSkills}"/>

			<Button Grid.Column="1"
					Command="{Binding AddFileCommand}"
					Classes="IconButton"
					ToolTip.Tip="{loc:Loc add}"
					IsEnabled="{Binding SkillSettings.EnableSkills}">
				<ico:MaterialIcon Kind="Plus"/>
			</Button>
		</Grid>

		<TextBlock Text="{loc:Loc settings-skills_additional_files_hint}"
				   Opacity="0.6"
				   TextWrapping="Wrap"/>

		<ItemsControl ItemsSource="{Binding SkillSettings.AdditionalSkillFiles}"
					  IsEnabled="{Binding SkillSettings.EnableSkills}">
			<ItemsControl.ItemTemplate>
				<DataTemplate x:DataType="x:String">
					<Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,2">
						<TextBox Grid.Column="0"
								 Text="{Binding Mode=TwoWay}"
								 PlaceholderText="{loc:Loc settings-skills_file_placeholder}"
								 VerticalContentAlignment="Center"/>

						<Button Grid.Column="1"
								Command="{Binding #VMRoot.DataContext.BrowseFileCommand}"
								CommandParameter="{Binding}"
								Classes="IconButton"
								Margin="4,0,0,0"
								ToolTip.Tip="{loc:Loc env_browse}">
							<ico:MaterialIcon Kind="FolderOpen"/>
						</Button>

						<Button Grid.Column="2"
								Command="{Binding #VMRoot.DataContext.OpenPathCommand}"
								CommandParameter="{Binding}"
								Classes="IconButton"
								Margin="2,0"
								ToolTip.Tip="{loc:Loc env_open_in_explorer}">
							<ico:MaterialIcon Kind="OpenInNew"/>
						</Button>

						<Button Grid.Column="3"
								Command="{Binding #VMRoot.DataContext.RemoveFileCommand}"
								CommandParameter="{Binding}"
								Classes="IconButton"
								Margin="2,0,0,0">
							<ico:MaterialIcon Kind="Close"/>
						</Button>
					</Grid>
				</DataTemplate>
			</ItemsControl.ItemTemplate>
		</ItemsControl>

	</StackPanel>

</UserControl>
