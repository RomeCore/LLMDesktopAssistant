<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 xmlns:local="using:LLMDesktopAssistant.LLM.MVVM.Settings"
			 xmlns:loc="using:LLMDesktopAssistant.Localization"
			 x:Class="LLMDesktopAssistant.LLM.MVVM.Settings.ChatToolsSettingsView"
			 x:DataType="local:ChatToolsSettingsViewModel">

	<StackPanel Margin="8" Spacing="8">

		<!-- Enable tools checkbox -->
		<CheckBox IsChecked="{Binding ToolSettings.EnableTools}"
							Content="{loc:Loc settings-use_tools}"/>

		<!-- Separator -->
		<Rectangle Height="1"
							 Fill="{DynamicResource DefaultForeground}"
							 Opacity="0.2"
							 Margin="0,10"/>

		<!-- ============================================================ -->
		<!-- FETCH FROM ALL WORKING DIRECTORIES -->
		<!-- ============================================================ -->
		<CheckBox IsChecked="{Binding ToolSettings.FetchFromAllWorkingDirectories}"
							Content="{loc:Loc settings-tools_fetch_all}"
							IsEnabled="{Binding ToolSettings.EnableTools}"/>

		<TextBlock Text="{loc:Loc settings-tools_fetch_all_hint}"
							Opacity="0.6"
							TextWrapping="Wrap"
							IsEnabled="{Binding ToolSettings.EnableTools}"/>

	</StackPanel>

</UserControl>
