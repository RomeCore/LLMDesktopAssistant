<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="using:LLMDesktopAssistant.LLM.MVVM.Additional"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="60"
             x:Class="LLMDesktopAssistant.LLM.MVVM.Additional.AgentTaskInlineView"
             x:DataType="local:AgentTaskInlineViewModel">

    <ContentControl Content="{Binding TaskViewModel}"
                    HorizontalAlignment="Left"/>

</UserControl>
