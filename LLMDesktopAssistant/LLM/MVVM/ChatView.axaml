<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 xmlns:local="clr-namespace:LLMDesktopAssistant.LLM.MVVM"
			 xmlns:loc="clr-namespace:LLMDesktopAssistant.Localization"
			 xmlns:beh="clr-namespace:LLMDesktopAssistant.Controls.Behaviours"
			 xmlns:ico="using:Material.Icons.Avalonia"
			 x:Class="LLMDesktopAssistant.LLM.MVVM.ChatView"
			 x:DataType="local:ChatViewModel">
	
	<Grid RowDefinitions="*,Auto" ColumnDefinitions="0.0*,2,*">

		<!-- Left Sidebar -->
		<TabControl Grid.Row="0" Grid.Column="0"
								ItemsSource="{Binding Chat.ContextTabs}">
			
			<TabControl.ItemTemplate>
				<DataTemplate>
					<TabItem Header="{Binding Title}"
									 IsVisible="{Binding IsVisible}"
									 Content="{Binding}"/>
				</DataTemplate>
			</TabControl.ItemTemplate>
			
		</TabControl>

		<!-- Splitter -->
		<GridSplitter Grid.Row="0" Grid.Column="1"
									ResizeDirection="Columns"/>

		<!-- Messages Area -->
		<Panel Grid.Row="0" Grid.Column="2">

			<!-- Agent Tasks button (top-right, mirrors ScrollToBottomButton) -->
			<Button x:Name="AgentTasksButton"
							Classes="BigIconButton"
							HorizontalAlignment="Right"
							VerticalAlignment="Top"
							Margin="32,16"
							ZIndex="10">

				<ico:MaterialIcon Kind="TimerSandComplete"/>
				
				<!-- Agent Tasks Popup -->
				<Button.Flyout>
					<Flyout Placement="BottomEdgeAlignedRight"
									HorizontalOffset="-16"
									VerticalOffset="4">
						
						<DockPanel>
							<Border Padding="8" CornerRadius="8"
										Width="420" MaxHeight="500"
										BoxShadow="0 4 16 rgba(0,0,0,0.3)">
								<StackPanel DockPanel.Dock="Top"
														Orientation="Horizontal"
														Spacing="8"
														Margin="0,0,0,8">
									<ico:MaterialIcon Kind="TimerSandComplete"
																		Width="18" Height="18"
																		VerticalAlignment="Center"/>
									<TextBlock Text="{loc:Loc agent_tasks}"
															FontSize="15" FontWeight="Bold"
															VerticalAlignment="Center"/>
								</StackPanel>
							</Border>
							<ScrollViewer MaxHeight="450">
								<ContentControl Content="{Binding AgentTaskList}"/>
							</ScrollViewer>
						</DockPanel>

					</Flyout>
				</Button.Flyout>
			</Button>

			<ScrollViewer x:Name="MessagesScrollViewer"
										ScrollChanged="MessagesScrollViewer_ScrollChanged"
										VerticalScrollBarVisibility="Visible"
										AllowAutoHide="False"
										BringIntoViewOnFocusChange="False"
										beh:ScrollViewerBehavior.AutoScrollEnabled="True">

				<StackPanel>
					<ContentControl Content="{Binding MessageSequence}"/>
					<ContentControl Content="{Binding ChatStatus}"/>
				</StackPanel>
			</ScrollViewer>

			<Button x:Name="ScrollToBottomButton"
							Classes="BigIconButton"
							Click="ScrollToBottomButton_Click"
							HorizontalAlignment="Right"
							VerticalAlignment="Bottom"
							Margin="32,16">
				<ico:MaterialIcon Kind="ArrowDown"/>
			</Button>

		</Panel>

		<!-- Input Area -->
		<Border Grid.Row="1" Grid.ColumnSpan="3"
						Padding="16,8"
						BorderBrush="{DynamicResource PrimaryAccentBrush}"
						BorderThickness="0,1,0,0">

			<ContentControl Content="{Binding UserInput}"/>
		</Border>
	</Grid>
	
</UserControl>
