<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 xmlns:local="using:LLMDesktopAssistant.LLM.MVVM.Settings"
			 xmlns:settings="using:LLMDesktopAssistant.LLM.Settings"
			 xmlns:loc="using:LLMDesktopAssistant.Localization"
			 xmlns:ico="using:Material.Icons.Avalonia"
			 x:Class="LLMDesktopAssistant.LLM.MVVM.Settings.ChatSubAgentsSettingsView"
			 x:DataType="local:ChatSubAgentsSettingsViewModel"
			 x:Name="VMRoot">

	<StackPanel Margin="8" Spacing="8">

		<!-- Enable sub-agents checkbox -->
		<CheckBox IsChecked="{Binding SubAgentSettings.EnableSubAgents}"
				  Content="{loc:Loc settings.sub_agents.enable}"/>

		<!-- Separator -->
		<Rectangle Height="1"
				   Fill="{DynamicResource DefaultForeground}"
				   Opacity="0.2"
				   Margin="0,10"/>

		<!-- ============================================================ -->
		<!-- AVAILABLE SUB-AGENTS                                         -->
		<!-- ============================================================ -->
		<Grid ColumnDefinitions="*,Auto,Auto">
			<TextBlock Grid.Column="0"
					   Text="{loc:Loc settings.sub_agents.available}"
					   FontSize="{DynamicResource FontSizeL}"
					   FontWeight="Bold"
					   VerticalAlignment="Center"/>

			<Button Grid.Column="1"
					Command="{Binding CreateSubAgentCommand}"
					Classes="IconButton"
					Margin="0,0,4,0"
					ToolTip.Tip="{loc:Loc settings.sub_agents.create}">
				<ico:MaterialIcon Kind="FilePlusOutline"/>
			</Button>

			<Button Grid.Column="2"
					Command="{Binding RefreshSubAgentsCommand}"
					Classes="IconButton"
					ToolTip.Tip="{loc:Loc settings.skills.refresh}">
				<ico:MaterialIcon Kind="Refresh"/>
			</Button>
		</Grid>

		<TextBlock Text="{loc:Loc settings.sub_agents.available.hint}"
				   Opacity="0.6"
				   TextWrapping="Wrap"/>

		<!-- Search -->
		<TextBox Text="{Binding SearchText, Mode=TwoWay}"
				 PlaceholderText="{loc:Loc settings.sub_agents.search.placeholder}"
				 IsEnabled="{Binding SubAgentSettings.EnableSubAgents}">
			<TextBox.InnerLeftContent>
				<ico:MaterialIcon Kind="TextBoxSearch" Width="16" Height="16" Margin="6,0" VerticalAlignment="Center" Opacity="0.5"/>
			</TextBox.InnerLeftContent>
		</TextBox>

		<!-- Empty state -->
		<TextBlock Text="{loc:Loc settings.sub_agents.empty}"
				   Opacity="0.5"
				   TextWrapping="Wrap"
				   IsVisible="{Binding AvailableSubAgents.Count, Converter={StaticResource InverseBooleanConverter}}"/>
		
		<Border BorderBrush="{DynamicResource SecondaryAccentBrush}"
						BorderThickness="1"
						CornerRadius="4">
			<ScrollViewer MaxHeight="600"
									  VerticalScrollBarVisibility="Auto"
									  HorizontalScrollBarVisibility="Disabled">
				<ItemsControl ItemsSource="{Binding AvailableSubAgents}"
										  IsEnabled="{Binding SubAgentSettings.EnableSubAgents}">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<StackPanel Orientation="Vertical" Spacing="8"/>
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>
					<ItemsControl.ItemTemplate>
						<DataTemplate x:DataType="local:SubAgentCardViewModel">
							<local:SubAgentCardView/>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</ScrollViewer>
		</Border>

		<!-- Separator -->
		<Rectangle Height="1"
				   Fill="{DynamicResource DefaultForeground}"
				   Opacity="0.2"
				   Margin="0,10"/>

		<!-- ============================================================ -->
		<!-- SUB-AGENT SOURCES                                            -->
		<!-- ============================================================ -->
		<Grid ColumnDefinitions="*,Auto">
			<TextBlock Grid.Column="0"
					   Text="{loc:Loc settings.sub_agents.sources}"
					   FontSize="{DynamicResource FontSizeL}"
					   FontWeight="Bold"
					   VerticalAlignment="Center"/>

			<ComboBox Grid.Column="1"
					  ItemsSource="{x:Static settings:InheritanceLevelItem.AllProfile}"
					  SelectedItem="{Binding SelectedSourcesInheritance}"
					  VerticalAlignment="Center"
					  MinWidth="120">

				<ComboBox.ItemTemplate>
					<DataTemplate x:DataType="settings:InheritanceLevelItem">
						<TextBlock Text="{Binding DisplayName}"/>
					</DataTemplate>
				</ComboBox.ItemTemplate>

			</ComboBox>
		</Grid>

		<!-- ============================================================ -->
		<!-- FETCH FROM ALL WORKING DIRECTORIES                           -->
		<!-- ============================================================ -->
		<CheckBox IsChecked="{Binding EffectiveSources.FetchFromAllWorkingDirectories}"
				  Content="{loc:Loc settings.sub_agents.fetch_all}"
				  ToolTip.Tip="{loc:Loc settings.sub_agents.fetch_all.hint}"
				  IsEnabled="{Binding SubAgentSettings.EnableSubAgents}"/>

		<!-- Separator -->
		<Rectangle Height="1"
				   Fill="{DynamicResource DefaultForeground}"
				   Opacity="0.2"
				   Margin="0,10"/>

		<!-- ============================================================ -->
		<!-- ADDITIONAL SUB-AGENT DIRECTORIES                             -->
		<!-- ============================================================ -->
		<Grid ColumnDefinitions="*,Auto">
			<TextBlock Grid.Column="0"
					   Text="{loc:Loc settings.sub_agents.additional_dirs}"
					   FontSize="{DynamicResource FontSizeL}"
					   FontWeight="Bold"
					   VerticalAlignment="Center"
					   IsEnabled="{Binding SubAgentSettings.EnableSubAgents}"/>

			<Button Grid.Column="1"
					Command="{Binding AddDirectoryCommand}"
					Classes="IconButton"
					ToolTip.Tip="{loc:Loc common.add}"
					IsEnabled="{Binding SubAgentSettings.EnableSubAgents}">
				<ico:MaterialIcon Kind="Plus"/>
			</Button>
		</Grid>

		<TextBlock Text="{loc:Loc settings.sub_agents.additional_dirs.hint}"
				   Opacity="0.6"
				   TextWrapping="Wrap"/>

		<ItemsControl ItemsSource="{Binding EffectiveSources.AdditionalSubAgentDirectories}"
					  IsEnabled="{Binding SubAgentSettings.EnableSubAgents}">
			<ItemsControl.ItemTemplate>
				<DataTemplate x:DataType="x:String">
					<Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,2">
						<TextBox Grid.Column="0"
								 Text="{Binding Mode=TwoWay}"
								 PlaceholderText="{loc:Loc settings.sub_agents.dir.placeholder}"
								 VerticalContentAlignment="Center"/>

						<Button Grid.Column="1"
								Command="{Binding #VMRoot.DataContext.BrowseDirectoryCommand}"
								CommandParameter="{Binding}"
								Classes="IconButton"
								Margin="4,0,0,0"
								ToolTip.Tip="{loc:Loc env.browse}">
							<ico:MaterialIcon Kind="FolderOpen"/>
						</Button>

						<Button Grid.Column="2"
								Command="{Binding #VMRoot.DataContext.OpenPathCommand}"
								CommandParameter="{Binding}"
								Classes="IconButton"
								Margin="2,0"
								ToolTip.Tip="{loc:Loc env.open_in_explorer}">
							<ico:MaterialIcon Kind="OpenInNew"/>
						</Button>

						<Button Grid.Column="3"
								Command="{Binding #VMRoot.DataContext.RemoveDirectoryCommand}"
								CommandParameter="{Binding}"
								Classes="IconButton"
								Margin="2,0,0,0">
							<ico:MaterialIcon Kind="Close"/>
						</Button>
					</Grid>
				</DataTemplate>
			</ItemsControl.ItemTemplate>
		</ItemsControl>

		<!-- Separator -->
		<Rectangle Height="1"
				   Fill="{DynamicResource DefaultForeground}"
				   Opacity="0.2"
				   Margin="0,10"/>

		<!-- ============================================================ -->
		<!-- ADDITIONAL SUB-AGENT FILES                                   -->
		<!-- ============================================================ -->
		<Grid ColumnDefinitions="*,Auto">
			<TextBlock Grid.Column="0"
					   Text="{loc:Loc settings.sub_agents.additional_files}"
					   FontSize="{DynamicResource FontSizeL}"
					   FontWeight="Bold"
					   VerticalAlignment="Center"
					   IsEnabled="{Binding SubAgentSettings.EnableSubAgents}"/>

			<Button Grid.Column="1"
					Command="{Binding AddFileCommand}"
					Classes="IconButton"
					ToolTip.Tip="{loc:Loc common.add}"
					IsEnabled="{Binding SubAgentSettings.EnableSubAgents}">
				<ico:MaterialIcon Kind="Plus"/>
			</Button>
		</Grid>

		<TextBlock Text="{loc:Loc settings.sub_agents.additional_files.hint}"
				   Opacity="0.6"
				   TextWrapping="Wrap"/>

		<ItemsControl ItemsSource="{Binding EffectiveSources.AdditionalSubAgentFiles}"
					  IsEnabled="{Binding SubAgentSettings.EnableSubAgents}">
			<ItemsControl.ItemTemplate>
				<DataTemplate x:DataType="x:String">
					<Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,2">
						<TextBox Grid.Column="0"
								 Text="{Binding Mode=TwoWay}"
								 PlaceholderText="{loc:Loc settings.sub_agents.file.placeholder}"
								 VerticalContentAlignment="Center"/>

						<Button Grid.Column="1"
								Command="{Binding #VMRoot.DataContext.BrowseFileCommand}"
								CommandParameter="{Binding}"
								Classes="IconButton"
								Margin="4,0,0,0"
								ToolTip.Tip="{loc:Loc env.browse}">
							<ico:MaterialIcon Kind="FolderOpen"/>
						</Button>

						<Button Grid.Column="2"
								Command="{Binding #VMRoot.DataContext.OpenPathCommand}"
								CommandParameter="{Binding}"
								Classes="IconButton"
								Margin="2,0"
								ToolTip.Tip="{loc:Loc env.open_in_explorer}">
							<ico:MaterialIcon Kind="OpenInNew"/>
						</Button>

						<Button Grid.Column="3"
								Command="{Binding #VMRoot.DataContext.RemoveFileCommand}"
								CommandParameter="{Binding}"
								Classes="IconButton"
								Margin="2,0,0,0">
							<ico:MaterialIcon Kind="Close"/>
						</Button>
					</Grid>
				</DataTemplate>
			</ItemsControl.ItemTemplate>
		</ItemsControl>

	</StackPanel>

</UserControl>
