<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d" d:DesignWidth="440" d:DesignHeight="300"
			 xmlns:local="using:LLMDesktopAssistant.LLM.MVVM.Settings"
			 xmlns:loc="using:LLMDesktopAssistant.Localization"
			 xmlns:ico="using:Material.Icons.Avalonia"
			 x:Class="LLMDesktopAssistant.LLM.MVVM.Settings.CreateMetaToolDialogView"
			 x:DataType="local:CreateMetaToolDialogViewModel">

	<Border Background="{DynamicResource CardBackground}"
			BorderBrush="{DynamicResource CardBorderBrush}"
			BorderThickness="1"
			CornerRadius="8"
			Padding="16"
			Margin="4"
			MinWidth="380"
			MaxWidth="520">

		<StackPanel Orientation="Vertical" Spacing="12">

			<!-- Header -->
			<StackPanel Orientation="Horizontal" Spacing="8">
				<ico:MaterialIcon Kind="FilePlusOutline" Width="20" Height="20"
								  VerticalAlignment="Center"
								  Foreground="{DynamicResource PrimaryAccentBrush}"/>
				<TextBlock Text="{loc:Loc settings.tools.meta_tools.create_dialog.title}"
						   FontSize="16"
						   FontWeight="Bold"
						   VerticalAlignment="Center"/>
			</StackPanel>

			<!-- Hint -->
			<TextBlock Text="{loc:Loc settings.tools.meta_tools.create_dialog.hint}"
					   FontSize="12"
					   Opacity="0.7"
					   TextWrapping="Wrap"/>

			<!-- Name -->
			<StackPanel Orientation="Vertical" Spacing="4">
				<TextBlock Text="{loc:Loc settings.tools.meta_tools.create_dialog.name}"
						   FontWeight="Medium"/>
				<TextBox Text="{Binding Name, Mode=TwoWay}"
						 PlaceholderText="{loc:Loc settings.tools.meta_tools.create_dialog.name.placeholder}"/>
			</StackPanel>

			<!-- Language -->
			<StackPanel Orientation="Vertical" Spacing="4">
				<TextBlock Text="{loc:Loc settings.tools.meta_tools.create_dialog.language}"
						   FontWeight="Medium"/>
				<ComboBox ItemsSource="{Binding Languages}"
						  SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
						  DisplayMemberBinding="{Binding DisplayName}"
						  HorizontalAlignment="Stretch"/>
			</StackPanel>

			<!-- Buttons -->
			<StackPanel Orientation="Horizontal"
						HorizontalAlignment="Right"
						Spacing="8"
						Margin="0,8,0,0">

				<Button Content="{loc:Loc common.cancel}"
						Command="{Binding CancelCommand}"
						Classes="Secondary"
						MinWidth="80"/>

				<Button Content="{loc:Loc common.create}"
						Command="{Binding CreateCommand}"
						MinWidth="80"/>

			</StackPanel>

		</StackPanel>

	</Border>

</UserControl>
