<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 xmlns:local="using:LLMDesktopAssistant.LLM.MVVM.Settings"
			 xmlns:settings="using:LLMDesktopAssistant.LLM.Settings"
			 xmlns:loc="using:LLMDesktopAssistant.Localization"
			 xmlns:ico="using:Material.Icons.Avalonia"
			 x:Class="LLMDesktopAssistant.LLM.MVVM.Settings.ChatAddonsSettingsView"
			 x:DataType="local:ChatAddonsSettingsViewModel"
			 x:Name="VMRoot">

	<StackPanel Margin="8" Spacing="8">

		<!-- ============================================================ -->
		<!-- SEARCH FOLDERS                                               -->
		<!-- ============================================================ -->
		<TextBlock Text="{loc:Loc addon.settings.search_folders}"
				   FontSize="{DynamicResource FontSizeL}"
				   FontWeight="Bold"/>

		<TextBlock Text="{loc:Loc addon.settings.search_folders.hint}"
				   Opacity="0.6"
				   TextWrapping="Wrap"/>

		<ItemsControl ItemsSource="{Binding SearchFolders}">
			<ItemsControl.ItemsPanel>
				<ItemsPanelTemplate>
					<WrapPanel/>
				</ItemsPanelTemplate>
			</ItemsControl.ItemsPanel>
			<ItemsControl.ItemTemplate>
				<DataTemplate x:DataType="x:String">
					<Border Background="{DynamicResource SecondaryAccentBrush}"
							CornerRadius="4"
							Padding="8,3"
							Margin="0,2,4,2">
						<TextBlock Text="{Binding}"
								   FontFamily="Consolas"
								   FontSize="12"/>
					</Border>
				</DataTemplate>
			</ItemsControl.ItemTemplate>
		</ItemsControl>

		<!-- Separator -->
		<Rectangle Height="1"
				   Fill="{DynamicResource DefaultForeground}"
				   Opacity="0.2"
				   Margin="0,10"/>

		<!-- ============================================================ -->
		<!-- ADDON SOURCES                                                -->
		<!-- ============================================================ -->
		<Grid ColumnDefinitions="*,Auto">
			<TextBlock Grid.Column="0"
					   Text="{loc:Loc addon.settings.sources}"
					   FontSize="{DynamicResource FontSizeL}"
					   FontWeight="Bold"
					   VerticalAlignment="Center"/>

			<ComboBox Grid.Column="1"
					  ItemsSource="{x:Static settings:InheritanceLevelItem.AllProfile}"
					  SelectedItem="{Binding SelectedFetchInheritance}"
					  VerticalAlignment="Center"
					  MinWidth="120">
				<ComboBox.ItemTemplate>
					<DataTemplate x:DataType="settings:InheritanceLevelItem">
						<TextBlock Text="{Binding DisplayName}"/>
					</DataTemplate>
				</ComboBox.ItemTemplate>
			</ComboBox>
		</Grid>

		<TextBlock Text="{loc:Loc addon.settings.sources.hint}"
				   Opacity="0.6"
				   TextWrapping="Wrap"/>

		<CheckBox IsChecked="{Binding EffectiveFetchFromAllWorkingDirectories}"
				  Content="{loc:Loc addon.settings.fetch_all}"/>

		<TextBlock Text="{loc:Loc addon.settings.fetch_all.hint}"
				   Opacity="0.6"
				   TextWrapping="Wrap"
				   Margin="24,0,0,0"/>

		<!-- Separator -->
		<Rectangle Height="1"
				   Fill="{DynamicResource DefaultForeground}"
				   Opacity="0.2"
				   Margin="0,10"/>

		<!-- ============================================================ -->
		<!-- ADDITIONAL PACK PATHS                                        -->
		<!-- ============================================================ -->
		<Grid ColumnDefinitions="*,Auto">
			<TextBlock Grid.Column="0"
					   Text="{loc:Loc addon.settings.additional_pack_paths}"
					   FontSize="{DynamicResource FontSizeL}"
					   FontWeight="Bold"
					   VerticalAlignment="Center"/>

			<ComboBox Grid.Column="1"
					  ItemsSource="{x:Static settings:InheritanceLevelItem.AllProfile}"
					  SelectedItem="{Binding SelectedPackPathsInheritance}"
					  VerticalAlignment="Center"
					  MinWidth="120">
				<ComboBox.ItemTemplate>
					<DataTemplate x:DataType="settings:InheritanceLevelItem">
						<TextBlock Text="{Binding DisplayName}"/>
					</DataTemplate>
				</ComboBox.ItemTemplate>
			</ComboBox>
		</Grid>

		<TextBlock Text="{loc:Loc addon.settings.additional_pack_paths.hint}"
				   Opacity="0.6"
				   TextWrapping="Wrap"/>

		<Grid ColumnDefinitions="*,Auto">
			<Button Grid.Column="1"
					Command="{Binding AddPackPathCommand}"
					Classes="IconButton"
					ToolTip.Tip="{loc:Loc common.add}">
				<ico:MaterialIcon Kind="Plus"/>
			</Button>
		</Grid>

		<ItemsControl ItemsSource="{Binding EffectiveAdditionalPackPaths}">
			<ItemsControl.ItemTemplate>
				<DataTemplate x:DataType="x:String">
					<Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,2">
						<TextBox Grid.Column="0"
								 Text="{Binding Mode=TwoWay}"
								 PlaceholderText="{loc:Loc addon.settings.additional_pack_paths.placeholder}"
								 VerticalContentAlignment="Center"/>

						<Button Grid.Column="1"
								Command="{Binding #VMRoot.DataContext.BrowsePackPathCommand}"
								CommandParameter="{Binding}"
								Classes="IconButton"
								Margin="4,0,0,0"
								ToolTip.Tip="{loc:Loc env.browse}">
							<ico:MaterialIcon Kind="FolderOpen"/>
						</Button>

						<Button Grid.Column="2"
								Command="{Binding #VMRoot.DataContext.OpenPathCommand}"
								CommandParameter="{Binding}"
								Classes="IconButton"
								Margin="2,0"
								ToolTip.Tip="{loc:Loc env.open_in_explorer}">
							<ico:MaterialIcon Kind="OpenInNew"/>
						</Button>

						<Button Grid.Column="3"
								Command="{Binding #VMRoot.DataContext.RemovePackPathCommand}"
								CommandParameter="{Binding}"
								Classes="IconButton"
								Margin="2,0,0,0">
							<ico:MaterialIcon Kind="Close"/>
						</Button>
					</Grid>
				</DataTemplate>
			</ItemsControl.ItemTemplate>
		</ItemsControl>

		<!-- Separator -->
		<Rectangle Height="1"
				   Fill="{DynamicResource DefaultForeground}"
				   Opacity="0.2"
				   Margin="0,10"/>

		<!-- ============================================================ -->
		<!-- ADDITIONAL SOURCES PER TYPE                                  -->
		<!-- ============================================================ -->
		<Grid ColumnDefinitions="*,Auto">
			<TextBlock Grid.Column="0"
					   Text="{loc:Loc addon.settings.addon_sources}"
					   FontSize="{DynamicResource FontSizeL}"
					   FontWeight="Bold"
					   VerticalAlignment="Center"/>

			<ComboBox Grid.Column="1"
					  ItemsSource="{x:Static settings:InheritanceLevelItem.AllProfile}"
					  SelectedItem="{Binding SelectedAddonSourcesInheritance}"
					  VerticalAlignment="Center"
					  MinWidth="120">
				<ComboBox.ItemTemplate>
					<DataTemplate x:DataType="settings:InheritanceLevelItem">
						<TextBlock Text="{Binding DisplayName}"/>
					</DataTemplate>
				</ComboBox.ItemTemplate>
			</ComboBox>
		</Grid>

		<TextBlock Text="{loc:Loc addon.settings.addon_sources.hint}"
				   Opacity="0.6"
				   TextWrapping="Wrap"/>

		<Grid ColumnDefinitions="*,Auto">
			<TextBox Grid.Column="0"
					 Text="{Binding NewSourceTypeName, Mode=TwoWay}"
					 PlaceholderText="{loc:Loc addon.settings.addon_sources.type_placeholder}"/>

			<Button Grid.Column="1"
					Command="{Binding AddSourceTypeCommand}"
					CommandParameter="{Binding NewSourceTypeName}"
					Classes="IconButton"
					Margin="4,0,0,0"
					ToolTip.Tip="{loc:Loc settings.skills.create}">
				<ico:MaterialIcon Kind="Plus"/>
			</Button>
		</Grid>

		<ItemsControl ItemsSource="{Binding AddonSourceItems}">
			<ItemsControl.ItemsPanel>
				<ItemsPanelTemplate>
					<StackPanel Orientation="Vertical" Spacing="8"/>
				</ItemsPanelTemplate>
			</ItemsControl.ItemsPanel>
			<ItemsControl.ItemTemplate>
				<DataTemplate x:DataType="local:AddonSourceItemViewModel">
					<Border BorderBrush="{DynamicResource SecondaryAccentBrush}"
									BorderThickness="1"
									CornerRadius="4"
									Padding="8"
									x:Name="VMItem"
									x:DataType="local:AddonSourceItemViewModel">
						<StackPanel Spacing="4">

							<Grid ColumnDefinitions="*,Auto">
								<TextBlock Grid.Column="0"
										   Text="{Binding TypeName}"
										   FontWeight="Bold"
										   VerticalAlignment="Center"/>

								<Button Grid.Column="1"
										Command="{Binding #VMRoot.DataContext.RemoveSourceTypeCommand}"
										CommandParameter="{Binding}"
										Classes="IconButton"
										ToolTip.Tip="{loc:Loc common.delete}">
									<ico:MaterialIcon Kind="Close"/>
								</Button>
							</Grid>

							<TextBlock Text="{loc:Loc addon.settings.addon_sources.directories}"
									   Opacity="0.7"/>
							<ItemsControl ItemsSource="{Binding Directories}">
								<ItemsControl.ItemTemplate>
									<DataTemplate x:DataType="x:String">
										<Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,2">
											<TextBox Grid.Column="0"
													 Text="{Binding Mode=TwoWay}"
													 PlaceholderText="{loc:Loc addon.settings.directory.placeholder}"
													 VerticalContentAlignment="Center"/>
											<Button Grid.Column="1"
													Command="{Binding #VMRoot.DataContext.OpenPathCommand}"
													CommandParameter="{Binding}"
													Classes="IconButton"
													Margin="4,0,0,0"
													ToolTip.Tip="{loc:Loc env.open_in_explorer}">
												<ico:MaterialIcon Kind="OpenInNew"/>
											</Button>
											<Button Grid.Column="2"
													Command="{Binding #VMItem.DataContext.RemoveDirectoryCommand}"
													CommandParameter="{Binding}"
													Classes="IconButton"
													Margin="2,0,0,0">
												<ico:MaterialIcon Kind="Close"/>
											</Button>
										</Grid>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
							<Button Command="{Binding AddDirectoryCommand}"
									Classes="IconButton"
									HorizontalAlignment="Left"
									ToolTip.Tip="{loc:Loc common.add}">
								<ico:MaterialIcon Kind="Plus"/>
							</Button>

							<TextBlock Text="{loc:Loc addon.settings.addon_sources.files}"
									   Opacity="0.7"/>
							<ItemsControl ItemsSource="{Binding Files}">
								<ItemsControl.ItemTemplate>
									<DataTemplate x:DataType="x:String">
										<Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,2">
											<TextBox Grid.Column="0"
													 Text="{Binding Mode=TwoWay}"
													 PlaceholderText="{loc:Loc addon.settings.file.placeholder}"
													 VerticalContentAlignment="Center"/>
											<Button Grid.Column="1"
													Command="{Binding #VMRoot.DataContext.OpenPathCommand}"
													CommandParameter="{Binding}"
													Classes="IconButton"
													Margin="4,0,0,0"
													ToolTip.Tip="{loc:Loc env.open_in_explorer}">
												<ico:MaterialIcon Kind="OpenInNew"/>
											</Button>
											<Button Grid.Column="2"
													Command="{Binding #VMItem.DataContext.RemoveFileCommand}"
													CommandParameter="{Binding}"
													Classes="IconButton"
													Margin="2,0,0,0">
												<ico:MaterialIcon Kind="Close"/>
											</Button>
										</Grid>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
							<Button Command="{Binding AddFileCommand}"
									Classes="IconButton"
									HorizontalAlignment="Left"
									ToolTip.Tip="{loc:Loc common.add}">
								<ico:MaterialIcon Kind="Plus"/>
							</Button>

						</StackPanel>
					</Border>
				</DataTemplate>
			</ItemsControl.ItemTemplate>
		</ItemsControl>

		<!-- Separator -->
		<Rectangle Height="1"
				   Fill="{DynamicResource DefaultForeground}"
				   Opacity="0.2"
				   Margin="0,10"/>

		<!-- ============================================================ -->
		<!-- ADDON PACKS                                                  -->
		<!-- ============================================================ -->
		<Grid ColumnDefinitions="*,Auto">
			<TextBlock Grid.Column="0"
					   Text="{loc:Loc addon.settings.packs}"
					   FontSize="{DynamicResource FontSizeL}"
					   FontWeight="Bold"
					   VerticalAlignment="Center"/>

			<ComboBox Grid.Column="1"
					  ItemsSource="{x:Static settings:InheritanceLevelItem.AllProfile}"
					  SelectedItem="{Binding SelectedPacksInheritance}"
					  VerticalAlignment="Center"
					  MinWidth="120">
				<ComboBox.ItemTemplate>
					<DataTemplate x:DataType="settings:InheritanceLevelItem">
						<TextBlock Text="{Binding DisplayName}"/>
					</DataTemplate>
				</ComboBox.ItemTemplate>
			</ComboBox>
		</Grid>

		<TextBlock Text="{loc:Loc addon.settings.packs.hint}"
				   Opacity="0.6"
				   TextWrapping="Wrap"/>

		<CheckBox IsChecked="{Binding EnablePacksByDefault}"
				  Content="{loc:Loc addon.settings.enable_packs_by_default}"/>

		<TextBlock Text="{loc:Loc addon.settings.enable_packs_by_default.hint}"
				   Opacity="0.6"
				   TextWrapping="Wrap"
				   Margin="24,0,0,0"/>

		<Grid ColumnDefinitions="*,Auto">
			<Button Grid.Column="1"
					Command="{Binding RefreshPacksCommand}"
					Classes="IconButton"
					ToolTip.Tip="{loc:Loc addon.settings.packs.refresh}">
				<ico:MaterialIcon Kind="Refresh"/>
			</Button>
		</Grid>

		<TextBlock Text="{loc:Loc addon.settings.packs.empty}"
				   Opacity="0.5"
				   TextWrapping="Wrap"
				   IsVisible="{Binding HasPacks, Converter={StaticResource InverseBooleanConverter}}"/>

		<ItemsControl ItemsSource="{Binding ConfigurablePacks}">
			<ItemsControl.ItemsPanel>
				<ItemsPanelTemplate>
					<StackPanel Orientation="Vertical" Spacing="6"/>
				</ItemsPanelTemplate>
			</ItemsControl.ItemsPanel>
			<ItemsControl.ItemTemplate>
				<DataTemplate x:DataType="local:AddonPackToggleItemViewModel">
					<Border BorderBrush="{DynamicResource SecondaryAccentBrush}"
							BorderThickness="1"
							CornerRadius="4"
							Padding="8,6">
						<Grid ColumnDefinitions="Auto,*,Auto">
							<CheckBox Grid.Column="0"
									  IsChecked="{Binding IsEnabled, Mode=TwoWay}"
									  VerticalAlignment="Center"
									  Margin="0,0,8,0"/>

							<StackPanel Grid.Column="1"
										Spacing="2">
								<TextBlock Text="{Binding Name}"
										   FontWeight="Bold"/>
								<TextBlock Text="{Binding Path}"
										   FontFamily="Consolas"
										   FontSize="11"
										   Opacity="0.7"
										   TextWrapping="Wrap"/>
								<TextBlock Text="{Binding Description}"
										   Opacity="0.7"
										   TextWrapping="Wrap"
										   IsVisible="{Binding Description, Converter={StaticResource StringNonEmptyToBooleanConverter}}"/>
							</StackPanel>

							<StackPanel Grid.Column="2"
										Spacing="2"
										HorizontalAlignment="Right">
								<TextBlock Text="{Binding SourceDisplay}"
										   Opacity="0.6"
										   FontSize="11"
										   HorizontalAlignment="Right"/>
								<TextBlock Text="{loc:Loc addon.settings.pack.manifest_invalid}"
										   Foreground="{DynamicResource DangerBrush}"
										   FontSize="11"
										   HorizontalAlignment="Right"
										   IsVisible="{Binding IsManifestInvalid}"/>
							</StackPanel>
						</Grid>
					</Border>
				</DataTemplate>
			</ItemsControl.ItemTemplate>
		</ItemsControl>

	</StackPanel>

</UserControl>
