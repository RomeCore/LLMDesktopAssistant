<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:local="using:LLMDesktopAssistant.LLM.MVVM.Settings.Agents"
			 xmlns:card="using:LLMDesktopAssistant.LLM.MVVM.Settings"
			 xmlns:set="using:LLMDesktopAssistant.LLM.Settings"
			 xmlns:loc="using:LLMDesktopAssistant.Localization"
			 xmlns:ico="using:Material.Icons.Avalonia"
			 mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="700"
			 x:Class="LLMDesktopAssistant.LLM.MVVM.Settings.Agents.AgentPromptSettingsView"
			 x:DataType="local:AgentPromptSettingsViewModel">

	<StackPanel Margin="8" Spacing="8">

		<!-- Preview Toggle -->
		<StackPanel Orientation="Horizontal"
					Spacing="6"
					Margin="0,0,0,4">

			<ToggleButton Command="{Binding TogglePreviewCommand}"
										ToolTip.Tip="{loc:Loc prompt.preview.toggle}"
										IsChecked="{Binding IsPreviewVisible, Mode=OneWay}">

				<StackPanel Orientation="Horizontal" Spacing="8">

					<ico:MaterialIcon Kind="Eye"
														Width="18" Height="18"/>

					<TextBlock Text="{loc:Loc prompt.preview.header}"
											FontWeight="Bold"
											VerticalAlignment="Center"/>

				</StackPanel>

			</ToggleButton>

		</StackPanel>

		<!-- Preview Content -->
		<TextBox IsVisible="{Binding IsPreviewVisible}"
						 Text="{Binding SystemPromptPreview}"
						 IsReadOnly="True"
						 AcceptsReturn="True"
						 TextWrapping="Wrap"
						 FontFamily="Cascadia Code,Consolas,monospace"
						 FontSize="12"
						 MinHeight="60"
						 MaxHeight="450"
						 ScrollViewer.VerticalScrollBarVisibility="Auto"/>

		<!-- Separator -->
		<Rectangle Height="1"
							 Fill="{DynamicResource DefaultForeground}"
							 Opacity="0.2"
							 IsVisible="{Binding IsPreviewVisible}"/>

		<!-- Search -->
		<TextBox Text="{Binding SearchText, Mode=TwoWay}"
				 PlaceholderText="{loc:Loc prompt.search.placeholder}">

			<TextBox.InnerLeftContent>
				<ico:MaterialIcon Kind="TextBoxSearch"
								  Width="16" Height="16"
								  Margin="6,0"
								  VerticalAlignment="Center"
								  Opacity="0.5"/>
			</TextBox.InnerLeftContent>

		</TextBox>

		<!-- Empty state -->
		<TextBlock Text="{loc:Loc prompt.empty}"
				   Opacity="0.5"
				   TextWrapping="Wrap"
				   IsVisible="{Binding IsAnyCardVisible, Converter={StaticResource InverseBooleanConverter}}"/>

		<!-- ============================================================ -->
		<!-- SYSTEM PROMPT SECTION                                        -->
		<!-- ============================================================ -->
		<StackPanel Spacing="6" IsVisible="{Binding IsSystemSectionVisible}">

			<Grid ColumnDefinitions="*,Auto,Auto,Auto">

				<TextBlock Grid.Column="0"
						   Text="{loc:Loc prompt.system_prompt}"
						   FontSize="{DynamicResource FontSizeL}"
						   FontWeight="Bold"
						   VerticalAlignment="Center"/>

				<!-- TODO: dialogs for creating/importing prompt parts are not implemented yet -->
				<Button Grid.Column="1"
						Classes="IconButton"
						IsEnabled="False"
						ToolTip.Tip="{loc:Loc prompt.todo.new}"
						VerticalAlignment="Center">
					<ico:MaterialIcon Kind="Plus"/>
				</Button>

				<Button Grid.Column="2"
						Classes="IconButton"
						IsEnabled="False"
						ToolTip.Tip="{loc:Loc prompt.todo.import}"
						VerticalAlignment="Center"
						Margin="0,0,8,0">
					<ico:MaterialIcon Kind="Import"/>
				</Button>

				<ComboBox Grid.Column="3"
						  ItemsSource="{x:Static set:InheritanceLevelItem.AllAgent}"
						  SelectedItem="{Binding SelectedSystemPromptInheritance}"
						  VerticalAlignment="Center"
						  MinWidth="120">

					<ComboBox.ItemTemplate>
						<DataTemplate x:DataType="set:InheritanceLevelItem">
							<TextBlock Text="{Binding DisplayName}"/>
						</DataTemplate>
					</ComboBox.ItemTemplate>

				</ComboBox>

			</Grid>

			<TextBlock Text="{loc:Loc prompt.slot_elements.hint}"
					   Opacity="0.6"
					   TextWrapping="Wrap"/>

			<CheckBox IsChecked="{Binding EffectiveSystemPrompt.UseCustomSystemPrompt, Mode=TwoWay}"
					  Content="{loc:Loc prompt.use_custom_system_prompt}"/>

			<TextBox IsVisible="{Binding EffectiveSystemPrompt.UseCustomSystemPrompt}"
					 Text="{Binding EffectiveSystemPrompt.CustomSystemPrompt, Mode=TwoWay}"
					 AcceptsReturn="True"
					 TextWrapping="Wrap"
					 MinHeight="80"
					 MaxHeight="200"
					 ScrollViewer.VerticalScrollBarVisibility="Auto"
					 PlaceholderText="{loc:Loc prompt.system_prompt.placeholder}"/>

			<ItemsControl ItemsSource="{Binding SystemElementCards}"
						  IsEnabled="{Binding EffectiveSystemPrompt.UseCustomSystemPrompt, Converter={StaticResource InverseBooleanConverter}}">
				<ItemsControl.ItemTemplate>
					<DataTemplate x:DataType="card:PromptPartCardViewModel">
						<card:PromptPartCardView/>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>

		</StackPanel>

		<!-- Separator -->
		<Rectangle Height="1"
				   Fill="{DynamicResource DefaultForeground}"
				   Opacity="0.2"
				   Margin="0,5"
				   IsVisible="{Binding IsSystemSectionVisible}"/>

		<!-- ============================================================ -->
		<!-- PERSONA SECTION                                              -->
		<!-- ============================================================ -->
		<StackPanel Spacing="6" IsVisible="{Binding IsPersonaSectionVisible}">

			<Grid ColumnDefinitions="*,Auto,Auto,Auto">

				<TextBlock Grid.Column="0"
						   Text="{loc:Loc prompt.persona}"
						   FontSize="{DynamicResource FontSizeL}"
						   FontWeight="Bold"
						   VerticalAlignment="Center"/>

				<!-- TODO: dialogs for creating/importing prompt parts are not implemented yet -->
				<Button Grid.Column="1"
						Classes="IconButton"
						IsEnabled="False"
						ToolTip.Tip="{loc:Loc prompt.todo.new}"
						VerticalAlignment="Center">
					<ico:MaterialIcon Kind="Plus"/>
				</Button>

				<Button Grid.Column="2"
						Classes="IconButton"
						IsEnabled="False"
						ToolTip.Tip="{loc:Loc prompt.todo.import}"
						VerticalAlignment="Center"
						Margin="0,0,8,0">
					<ico:MaterialIcon Kind="Import"/>
				</Button>

				<ComboBox Grid.Column="3"
						  ItemsSource="{x:Static set:InheritanceLevelItem.AllAgent}"
						  SelectedItem="{Binding SelectedPersonaInheritance}"
						  VerticalAlignment="Center"
						  MinWidth="120">

					<ComboBox.ItemTemplate>
						<DataTemplate x:DataType="set:InheritanceLevelItem">
							<TextBlock Text="{Binding DisplayName}"/>
						</DataTemplate>
					</ComboBox.ItemTemplate>

				</ComboBox>

			</Grid>

			<!-- Nickname -->
			<TextBlock Text="{loc:Loc prompt.assistant_nickname.hint}"
					   Opacity="0.6"/>

			<TextBox Text="{Binding EffectivePersona.Nickname, Mode=TwoWay}"
					 TextWrapping="NoWrap"
					 PlaceholderText="{loc:Loc prompt.user_nickname.placeholder}"/>

			<CheckBox IsChecked="{Binding EffectivePersona.UseCustomPersona, Mode=TwoWay}"
					  Content="{loc:Loc prompt.use_custom_persona}"/>

			<TextBox IsVisible="{Binding EffectivePersona.UseCustomPersona}"
					 Text="{Binding EffectivePersona.CustomPersona, Mode=TwoWay}"
					 AcceptsReturn="True"
					 TextWrapping="Wrap"
					 MinHeight="100"
					 MaxHeight="200"
					 ScrollViewer.VerticalScrollBarVisibility="Auto"
					 PlaceholderText="{loc:Loc prompt.custom_persona.placeholder}"/>

			<ItemsControl ItemsSource="{Binding PersonaElementCards}"
						  IsEnabled="{Binding EffectivePersona.UseCustomPersona, Converter={StaticResource InverseBooleanConverter}}">
				<ItemsControl.ItemTemplate>
					<DataTemplate x:DataType="card:PromptPartCardViewModel">
						<card:PromptPartCardView/>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>

		</StackPanel>

		<!-- Separator -->
		<Rectangle Height="1"
				   Fill="{DynamicResource DefaultForeground}"
				   Opacity="0.2"
				   Margin="0,5"
				   IsVisible="{Binding IsPersonaSectionVisible}"/>

		<!-- ============================================================ -->
		<!-- SPECIALIZATION SECTION                                       -->
		<!-- ============================================================ -->
		<StackPanel Spacing="6" IsVisible="{Binding IsSpecializationSectionVisible}">

			<Grid ColumnDefinitions="*,Auto,Auto,Auto">

				<TextBlock Grid.Column="0"
						   Text="{loc:Loc prompt.specialization}"
						   FontSize="{DynamicResource FontSizeL}"
						   FontWeight="Bold"
						   VerticalAlignment="Center"/>

				<!-- TODO: dialogs for creating/importing prompt parts are not implemented yet -->
				<Button Grid.Column="1"
						Classes="IconButton"
						IsEnabled="False"
						ToolTip.Tip="{loc:Loc prompt.todo.new}"
						VerticalAlignment="Center">
					<ico:MaterialIcon Kind="Plus"/>
				</Button>

				<Button Grid.Column="2"
						Classes="IconButton"
						IsEnabled="False"
						ToolTip.Tip="{loc:Loc prompt.todo.import}"
						VerticalAlignment="Center"
						Margin="0,0,8,0">
					<ico:MaterialIcon Kind="Import"/>
				</Button>

				<ComboBox Grid.Column="3"
						  ItemsSource="{x:Static set:InheritanceLevelItem.AllAgent}"
						  SelectedItem="{Binding SelectedSpecializationInheritance}"
						  VerticalAlignment="Center"
						  MinWidth="120">

					<ComboBox.ItemTemplate>
						<DataTemplate x:DataType="set:InheritanceLevelItem">
							<TextBlock Text="{Binding DisplayName}"/>
						</DataTemplate>
					</ComboBox.ItemTemplate>

				</ComboBox>

			</Grid>

			<TextBlock Text="{loc:Loc prompt.specialization.hint}"
					   Opacity="0.6"
					   TextWrapping="Wrap"/>

			<CheckBox IsChecked="{Binding EffectiveSpecialization.UseCustomSpecialization, Mode=TwoWay}"
					  Content="{loc:Loc prompt.use_custom_specialization}"/>

			<TextBox IsVisible="{Binding EffectiveSpecialization.UseCustomSpecialization}"
					 Text="{Binding EffectiveSpecialization.CustomSpecialization, Mode=TwoWay}"
					 AcceptsReturn="True"
					 TextWrapping="Wrap"
					 MinHeight="100"
					 MaxHeight="200"
					 ScrollViewer.VerticalScrollBarVisibility="Auto"
					 PlaceholderText="{loc:Loc prompt.custom_specialization.placeholder}"/>

			<ItemsControl ItemsSource="{Binding SpecializationElementCards}"
						  IsEnabled="{Binding EffectiveSpecialization.UseCustomSpecialization, Converter={StaticResource InverseBooleanConverter}}">
				<ItemsControl.ItemTemplate>
					<DataTemplate x:DataType="card:PromptPartCardViewModel">
						<card:PromptPartCardView/>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>

		</StackPanel>

		<!-- Separator -->
		<Rectangle Height="1"
				   Fill="{DynamicResource DefaultForeground}"
				   Opacity="0.2"
				   Margin="0,5"
				   IsVisible="{Binding IsSpecializationSectionVisible}"/>

		<!-- ============================================================ -->
		<!-- COMPONENTS SECTION                                           -->
		<!-- ============================================================ -->
		<StackPanel Spacing="6" IsVisible="{Binding IsComponentsSectionVisible}">

			<Grid ColumnDefinitions="*,Auto,Auto,Auto">

				<TextBlock Grid.Column="0"
						   Text="{loc:Loc prompt.components}"
						   FontSize="{DynamicResource FontSizeL}"
						   FontWeight="Bold"
						   VerticalAlignment="Center"/>

				<!-- TODO: dialogs for creating/importing prompt parts are not implemented yet -->
				<Button Grid.Column="1"
						Classes="IconButton"
						IsEnabled="False"
						ToolTip.Tip="{loc:Loc prompt.todo.new}"
						VerticalAlignment="Center">
					<ico:MaterialIcon Kind="Plus"/>
				</Button>

				<Button Grid.Column="2"
						Classes="IconButton"
						IsEnabled="False"
						ToolTip.Tip="{loc:Loc prompt.todo.import}"
						VerticalAlignment="Center"
						Margin="0,0,8,0">
					<ico:MaterialIcon Kind="Import"/>
				</Button>

				<ComboBox Grid.Column="3"
						  ItemsSource="{x:Static set:InheritanceLevelItem.AllAgent}"
						  SelectedItem="{Binding SelectedComponentsInheritance}"
						  VerticalAlignment="Center"
						  MinWidth="120">

					<ComboBox.ItemTemplate>
						<DataTemplate x:DataType="set:InheritanceLevelItem">
							<TextBlock Text="{Binding DisplayName}"/>
						</DataTemplate>
					</ComboBox.ItemTemplate>

				</ComboBox>

			</Grid>

			<TextBlock Text="{loc:Loc prompt.components.hint}"
					   Opacity="0.6"
					   TextWrapping="Wrap"/>

			<ItemsControl ItemsSource="{Binding ComponentCards}">
				<ItemsControl.ItemTemplate>
					<DataTemplate x:DataType="card:PromptPartCardViewModel">
						<card:PromptPartCardView/>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>

		</StackPanel>

		<!-- Separator -->
		<Rectangle Height="1"
				   Fill="{DynamicResource DefaultForeground}"
				   Opacity="0.2"
				   Margin="0,5"
				   IsVisible="{Binding IsComponentsSectionVisible}"/>

		<!-- ============================================================ -->
		<!-- BEHAVIOR SLIDERS                                             -->
		<!-- ============================================================ -->
		<StackPanel Spacing="6">

			<Grid ColumnDefinitions="*,Auto">

				<TextBlock Grid.Column="0"
						   Text="{loc:Loc prompt.behavior_sliders}"
						   FontSize="{DynamicResource FontSizeL}"
						   FontWeight="Bold"
						   VerticalAlignment="Center"/>

				<ComboBox Grid.Column="1"
						  ItemsSource="{x:Static set:InheritanceLevelItem.AllAgent}"
						  SelectedItem="{Binding SelectedSliderValuesInheritance}"
						  VerticalAlignment="Center"
						  MinWidth="120">

					<ComboBox.ItemTemplate>
						<DataTemplate x:DataType="set:InheritanceLevelItem">
							<TextBlock Text="{Binding DisplayName}"/>
						</DataTemplate>
					</ComboBox.ItemTemplate>

				</ComboBox>

			</Grid>

			<TextBlock Text="{loc:Loc prompt.behavior_sliders.hint}"
					   Opacity="0.6"
					   TextWrapping="Wrap"/>

			<ItemsControl ItemsSource="{Binding SliderItems}">

				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<StackPanel Margin="0,6">

							<TextBlock Text="{Binding DisplayName}"
									   FontWeight="Medium"
									   FontSize="{DynamicResource FontSizeM}"
									   Margin="0,0,0,4"/>

							<ItemsControl x:Name="HintItemsControl"
										  SizeChanged="HintItemsControl_SizeChanged"
										  Margin="10,0"
										  ItemsSource="{Binding Hints}">

								<ItemsControl.ItemsPanel>
									<ItemsPanelTemplate>
										<UniformGrid Columns="{Binding Range}"/>
									</ItemsPanelTemplate>
								</ItemsControl.ItemsPanel>

								<ItemsControl.ItemTemplate>
									<DataTemplate x:DataType="local:BehaviorSliderHintViewModel">
										<TextBlock Text="{Binding Label}"
												   Opacity="0.6"
												   TextAlignment="Center"
												   VerticalAlignment="Bottom"
												   HorizontalAlignment="Center"
												   Grid.Column="{Binding Column}"/>
									</DataTemplate>
								</ItemsControl.ItemTemplate>

							</ItemsControl>

							<Slider x:Name="BehaviorSlider"
									Value="{Binding Value, Mode=TwoWay}"
									Minimum="{Binding MinValue}"
									Maximum="{Binding MaxValue}"
									TickFrequency="1"
									HorizontalAlignment="Stretch"
									IsSnapToTickEnabled="True"
									TickPlacement="TopLeft"/>

						</StackPanel>
					</DataTemplate>
				</ItemsControl.ItemTemplate>

			</ItemsControl>

		</StackPanel>

	</StackPanel>

</UserControl>
