<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 xmlns:local="using:LLMDesktopAssistant.LLM.MVVM.Settings.Agents"
			 xmlns:cards="using:LLMDesktopAssistant.Addons.MVVM"
			 xmlns:settings="using:LLMDesktopAssistant.LLM.Settings"
			 xmlns:loc="using:LLMDesktopAssistant.Localization"
			 xmlns:ico="using:Material.Icons.Avalonia"
			 x:Class="LLMDesktopAssistant.LLM.MVVM.Settings.Agents.AgentSkillSettingsView"
			 x:DataType="local:AgentSkillSettingsViewModel">

	<StackPanel Margin="8" Spacing="8">

		<!-- Enable skills checkbox -->
		<CheckBox IsChecked="{Binding SkillSettings.EnableSkills}"
				  Content="{loc:Loc settings.skills.enable}"/>

		<Rectangle Height="1"
				   Fill="{DynamicResource DefaultForeground}"
				   Opacity="0.2"
				   Margin="0,10"/>

		<Grid ColumnDefinitions="*,Auto">
			<TextBlock Grid.Column="0"
					   Text="{loc:Loc settings.agent.skills.skill_list}"
					   FontSize="{DynamicResource FontSizeL}"
					   FontWeight="Bold"
					   VerticalAlignment="Center"/>

			<ComboBox Grid.Column="1"
					  ItemsSource="{x:Static settings:InheritanceLevelItem.AllAgent}"
					  SelectedItem="{Binding SelectedSkillChangesInheritance}"
					  VerticalAlignment="Center"
					  MinWidth="120">

				<ComboBox.ItemTemplate>
					<DataTemplate x:DataType="settings:InheritanceLevelItem">
						<TextBlock Text="{Binding DisplayName}"/>
					</DataTemplate>
				</ComboBox.ItemTemplate>

			</ComboBox>
		</Grid>

		<TextBlock Text="{loc:Loc settings.agent.skills.skill_list.hint}"
				   Opacity="0.6"
				   TextWrapping="Wrap"/>

		<Rectangle Height="1"
				   Fill="{DynamicResource DefaultForeground}"
				   Opacity="0.2"/>

		<CheckBox IsChecked="{Binding EffectiveSkillset.EnabledByDefault, Mode=TwoWay}"
				  Content="{loc:Loc skill.skills_enabled_by_default}"/>

		<TextBlock Text="{loc:Loc skill.skills_enabled_by_default.hint}"
				   Opacity="0.5"
				   FontSize="11"
				   Margin="24,0,0,4"
				   TextWrapping="Wrap"/>

		<!-- Search -->
		<TextBox Text="{Binding SearchText, Mode=TwoWay}"
				 PlaceholderText="{loc:Loc settings.skills.search.placeholder}"
				 IsEnabled="{Binding SkillSettings.EnableSkills}">
			<TextBox.InnerLeftContent>
				<ico:MaterialIcon Kind="TextBoxSearch" Width="16" Height="16" Margin="6,0" VerticalAlignment="Center" Opacity="0.5"/>
			</TextBox.InnerLeftContent>
		</TextBox>

		<!-- Empty state -->
		<TextBlock Text="{loc:Loc settings.skills.empty}"
				   Opacity="0.5"
				   TextWrapping="Wrap"
				   IsVisible="{Binding Items.Count, Converter={StaticResource InverseBooleanConverter}}"/>

		<Border BorderBrush="{DynamicResource SecondaryAccentBrush}"
				BorderThickness="1"
				CornerRadius="4">
			<ScrollViewer MaxHeight="500"
						  VerticalScrollBarVisibility="Auto"
						  HorizontalScrollBarVisibility="Disabled">
				<ItemsControl ItemsSource="{Binding Items}"
							  IsEnabled="{Binding SkillSettings.EnableSkills}">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<StackPanel Orientation="Vertical" Spacing="8"/>
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>
				</ItemsControl>
			</ScrollViewer>
		</Border>

	</StackPanel>

</UserControl>
