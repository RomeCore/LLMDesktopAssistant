<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
			 xmlns:local="using:LLMDesktopAssistant.LLM.MVVM.Settings.Agents"
			 xmlns:set="using:LLMDesktopAssistant.LLM.Settings"
			 xmlns:agt="using:LLMDesktopAssistant.Agents"
			 xmlns:loc="using:LLMDesktopAssistant.Localization"
			 xmlns:ico="using:Material.Icons.Avalonia"
			 xmlns:ctrl="using:LLMDesktopAssistant.Controls"
			 x:Name="ThisControl"
			 x:Class="LLMDesktopAssistant.LLM.MVVM.Settings.Agents.AgentGenerationSettingsView"
			 x:DataType="local:AgentGenerationSettingsViewModel">

	<StackPanel Orientation="Vertical" Margin="8" Spacing="8">
			
		<!-- ============================================================ -->
		<!-- CUSTOM MODEL -->
		<!-- ============================================================ -->
		<Grid ColumnDefinitions="*,Auto">

			<TextBlock Grid.Column="0"
						  Text="{loc:Loc settings.agent.generation.custom_model}"
						  FontWeight="Bold"
						  FontSize="{DynamicResource FontSizeL}"
						  VerticalAlignment="Center"/>

			<ComboBox Grid.Column="1"
						  ItemsSource="{x:Static set:InheritanceLevelItem.AllAgent}"
						  SelectedItem="{Binding SelectedCustomModelInheritance}"
						  VerticalAlignment="Center"
						  Margin="0,0,8,0"
						  MinWidth="120">

				<ComboBox.ItemTemplate>
					<DataTemplate x:DataType="set:InheritanceLevelItem">
						<TextBlock Text="{Binding DisplayName}"/>
					</DataTemplate>
				</ComboBox.ItemTemplate>

			</ComboBox>

		</Grid>

		<CheckBox Content="{loc:Loc settings.agent.generation.enable_custom_model}"
					IsChecked="{Binding EffectiveCustomModel.EnableCustomModel, Mode=TwoWay}"/>

		<StackPanel Orientation="Vertical"
					Spacing="4"
					Margin="20,0,0,0"
					IsEnabled="{Binding EffectiveCustomModel.EnableCustomModel}">

			<ctrl:ModelSelectorControl SelectedModel="{Binding EffectiveCustomModel.Model, Mode=TwoWay}"/>

		</StackPanel>

		<!-- Separator -->
		<Rectangle Height="1"
					  Fill="{DynamicResource DefaultForeground}"
					  Opacity="0.2"
					  Margin="0,10"/>

		<!-- ============================================================ -->
		<!-- REASONING -->
		<!-- ============================================================ -->
		<Grid ColumnDefinitions="*,Auto">

			<TextBlock Grid.Column="0"
						  Text="{loc:Loc settings.agent.generation.reasoning}"
						  FontWeight="Bold"
						  FontSize="{DynamicResource FontSizeL}"
						  VerticalAlignment="Center"/>

			<ComboBox Grid.Column="1"
						  ItemsSource="{x:Static set:InheritanceLevelItem.AllAgent}"
						  SelectedItem="{Binding SelectedReasoningInheritance}"
						  VerticalAlignment="Center"
						  Margin="0,0,8,0"
						  MinWidth="120">

				<ComboBox.ItemTemplate>
					<DataTemplate x:DataType="set:InheritanceLevelItem">
						<TextBlock Text="{Binding DisplayName}"/>
					</DataTemplate>
				</ComboBox.ItemTemplate>

			</ComboBox>

		</Grid>

		<CheckBox Content="{loc:Loc settings.agent.generation.enable_reasoning}"
					IsChecked="{Binding EffectiveReasoning.EnableReasoningSettings, Mode=TwoWay}"/>

		<StackPanel Orientation="Horizontal"
					Spacing="8"
					Margin="20,0,0,0"
					IsEnabled="{Binding EffectiveReasoning.EnableReasoningSettings}">

			<TextBlock Text="{loc:Loc settings.agent.generation.reasoning_level}"
						  VerticalAlignment="Center"/>

			<ComboBox MinWidth="160"
						SelectedItem="{Binding SelectedReasoningLevel, Mode=TwoWay}"
						ItemsSource="{Binding ReasoningLevels}"
						VerticalAlignment="Center">

				<ComboBox.ItemTemplate>
					<DataTemplate x:DataType="local:ReasoningLevelItem">
						<TextBlock Text="{Binding DisplayName}"/>
					</DataTemplate>
				</ComboBox.ItemTemplate>

			</ComboBox>

		</StackPanel>

		<!-- Separator -->
		<Rectangle Height="1"
					  Fill="{DynamicResource DefaultForeground}"
					  Opacity="0.2"
					  Margin="0,10"/>

		<!-- ============================================================ -->
		<!-- TEMPERATURE -->
		<!-- ============================================================ -->
		<Grid ColumnDefinitions="*,Auto">

			<TextBlock Grid.Column="0"
						  Text="{loc:Loc settings.agent.generation.temperature}"
						  FontWeight="Bold"
						  FontSize="{DynamicResource FontSizeL}"
						  VerticalAlignment="Center"/>

			<ComboBox Grid.Column="1"
						  ItemsSource="{x:Static set:InheritanceLevelItem.AllAgent}"
						  SelectedItem="{Binding SelectedTemperatureInheritance}"
						  VerticalAlignment="Center"
						  Margin="0,0,8,0"
						  MinWidth="120">

				<ComboBox.ItemTemplate>
					<DataTemplate x:DataType="set:InheritanceLevelItem">
						<TextBlock Text="{Binding DisplayName}"/>
					</DataTemplate>
				</ComboBox.ItemTemplate>

			</ComboBox>

		</Grid>

		<CheckBox Content="{loc:Loc settings.agent.generation.enable_temperature}"
					IsChecked="{Binding EffectiveTemperature.EnableTemperature, Mode=TwoWay}"/>

		<StackPanel Orientation="Vertical"
					Spacing="4"
					Margin="20,0,0,0"
					IsEnabled="{Binding EffectiveTemperature.EnableTemperature}">

			<Grid ColumnDefinitions="Auto,*,50"
					ColumnSpacing="8">

				<TextBlock Text="{loc:Loc settings.agent.generation.temperature_value}"
							  VerticalAlignment="Center"/>

				<Slider Grid.Column="1"
						Value="{Binding EffectiveTemperature.Temperature, Mode=TwoWay}"
						Minimum="0.0"
						Maximum="2.0"
						TickFrequency="0.1"
						TickPlacement="Outside"
						IsSnapToTickEnabled="True"
						VerticalAlignment="Center"/>

				<TextBlock Grid.Column="2"
						Text="{Binding EffectiveTemperature.Temperature, StringFormat=F2}"
						Margin="4"
						VerticalAlignment="Center"
						HorizontalAlignment="Right"/>

			</Grid>

		</StackPanel>

		<!-- ============================================================ -->
		<!-- MAX TOKENS -->
		<!-- ============================================================ -->
		<Rectangle Height="1"
					  Fill="{DynamicResource DefaultForeground}"
					  Opacity="0.2"
					  Margin="0,10"/>

		<Grid ColumnDefinitions="*,Auto">

			<TextBlock Grid.Column="0"
						  Text="{loc:Loc settings.agent.generation.max_tokens}"
						  FontWeight="Bold"
						  FontSize="{DynamicResource FontSizeL}"
						  VerticalAlignment="Center"/>

			<ComboBox Grid.Column="1"
						  ItemsSource="{x:Static set:InheritanceLevelItem.AllAgent}"
						  SelectedItem="{Binding SelectedMaxTokensInheritance}"
						  VerticalAlignment="Center"
						  Margin="0,0,8,0"
						  MinWidth="120">

				<ComboBox.ItemTemplate>
					<DataTemplate x:DataType="set:InheritanceLevelItem">
						<TextBlock Text="{Binding DisplayName}"/>
					</DataTemplate>
				</ComboBox.ItemTemplate>

			</ComboBox>

		</Grid>

		<CheckBox Content="{loc:Loc settings.agent.generation.enable_max_tokens}"
					IsChecked="{Binding EffectiveMaxTokens.EnableMaxTokens, Mode=TwoWay}"/>

		<StackPanel Orientation="Horizontal"
					Spacing="8"
					Margin="20,0,0,0"
					IsEnabled="{Binding EffectiveMaxTokens.EnableMaxTokens}">

			<TextBlock Text="{loc:Loc settings.agent.generation.max_tokens_value}"
						  VerticalAlignment="Center"/>

			<NumericUpDown MinWidth="120"
							  Minimum="1"
							  Maximum="1048576"
								AllowSpin="True"
								Increment="1024"
							  Value="{Binding EffectiveMaxTokens.MaxTokens, Mode=TwoWay}"
							  VerticalAlignment="Center"/>

		</StackPanel>

		<!-- Separator -->
		<Rectangle Height="1"
					  Fill="{DynamicResource DefaultForeground}"
					  Opacity="0.2"
					  Margin="0,10"/>

		<!-- ============================================================ -->
		<!-- ADDITIONAL PARAMETERS -->
		<!-- ============================================================ -->
		<Grid ColumnDefinitions="*,Auto,Auto"
				Margin="0,5,0,0">

			<TextBlock Grid.Column="0"
						  Text="{loc:Loc settings.agent.generation.additional_parameters}"
						  FontWeight="Bold"
						  FontSize="{DynamicResource FontSizeL}"
						  VerticalAlignment="Center"/>

			<ComboBox Grid.Column="1"
						  ItemsSource="{x:Static set:InheritanceLevelItem.AllAgent}"
						  SelectedItem="{Binding SelectedAdditionalParametersInheritance}"
						  VerticalAlignment="Center"
						  Margin="0,0,8,0"
						  MinWidth="120">

				<ComboBox.ItemTemplate>
					<DataTemplate x:DataType="set:InheritanceLevelItem">
						<TextBlock Text="{Binding DisplayName}"/>
					</DataTemplate>
				</ComboBox.ItemTemplate>

			</ComboBox>

			<Button Grid.Column="2"
					Command="{Binding AddParameterCommand}"
					Classes="IconButton"
					ToolTip.Tip="{loc:Loc common.add}">

				<ico:MaterialIcon Kind="Plus"/>

			</Button>

		</Grid>

		<TextBlock Text="{loc:Loc settings.agent.generation.additional_parameters.hint}"
					  Opacity="0.6"
					  TextWrapping="Wrap"
					  Margin="0,0,0,5"/>
			
		<Border BorderBrush="{DynamicResource DefaultForeground}"
				BorderThickness="1"
				CornerRadius="4"
				Padding="6"
				IsVisible="{Binding EffectiveAdditionalParameters.Any}">
				
			<ItemsControl ItemsSource="{Binding EffectiveAdditionalParameters}">

				<ItemsControl.ItemTemplate>
					<DataTemplate x:DataType="agt:AdditionalParameter">
						<Grid ColumnDefinitions="Auto,*,Auto,*,Auto,Auto"
								RowDefinitions="Auto"
								ColumnSpacing="6"
								Margin="0,2">

							<CheckBox Grid.Column="0"
										IsChecked="{Binding Enabled, Mode=TwoWay}"
										VerticalAlignment="Center"/>

							<TextBox Grid.Column="1"
										PlaceholderText="{loc:Loc settings.agent.generation.param.name}"
										Text="{Binding ParameterName, Mode=TwoWay}"
										MinWidth="100"/>

							<TextBlock Grid.Column="2"
											Text="="
											VerticalAlignment="Center"
											FontWeight="Bold"/>

							<TextBox Grid.Column="3"
										PlaceholderText="{loc:Loc settings.agent.generation.param.value}"
										Text="{Binding ParameterValue, Mode=TwoWay}"
										MinWidth="100"/>

							<!-- Delete button -->
							<Button Grid.Column="5"
									Command="{Binding #ThisControl.DataContext.RemoveParameterCommand}"
									CommandParameter="{Binding}"
									Classes="IconButton"
									ToolTip.Tip="{loc:Loc common.remove}">

								<ico:MaterialIcon Kind="Close"/>

							</Button>

						</Grid>
					</DataTemplate>
				</ItemsControl.ItemTemplate>

			</ItemsControl>

		</Border>

	</StackPanel>

</UserControl>
