<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 xmlns:local="using:LLMDesktopAssistant.LLM.MVVM.Settings.Agents"
			 xmlns:sett="using:LLMDesktopAssistant.LLM.MVVM.Settings"
			 xmlns:set="using:LLMDesktopAssistant.LLM.Settings"
			 xmlns:appset="using:LLMDesktopAssistant.Settings"
			 xmlns:llmsg="using:LLMDesktopAssistant.LLM.Messages"
			 xmlns:loc="using:LLMDesktopAssistant.Localization"
			 xmlns:ico="using:Material.Icons.Avalonia"
			 xmlns:ctrl="using:LLMDesktopAssistant.Controls"
			 xmlns:flui="using:FluentAvalonia.UI"
			 x:Class="LLMDesktopAssistant.LLM.MVVM.Settings.Agents.AgentToolSettingsView"
			 x:DataType="local:AgentToolSettingsViewModel">

	<StackPanel Margin="8" Spacing="8">

		<!-- Enable tools checkbox -->
		<CheckBox IsChecked="{Binding ToolSettings.EnableTools}"
							Content="{loc:Loc settings.tools.enable}"/>

		<!-- Separator -->
		<Rectangle Height="1"
							 Fill="{DynamicResource DefaultForeground}"
							 Opacity="0.2"/>

		<!-- ============================================================ -->
		<!-- BEHAVIOUR POLICY -->
		<!-- ============================================================ -->
		<Grid ColumnDefinitions="*,Auto">

			<TextBlock Grid.Column="0"
								 Text="{loc:Loc settings.agent.tools.behaviour_policy}"
								 FontSize="{DynamicResource FontSizeL}"
								 FontWeight="Bold"
								 VerticalAlignment="Center"/>

			<ComboBox Grid.Column="1"
								ItemsSource="{x:Static set:InheritanceLevelItem.AllAgent}"
								SelectedItem="{Binding SelectedPolicyInheritance}"
								VerticalAlignment="Center"
								Margin="0,0,8,0"
								MinWidth="120">

				<ComboBox.ItemTemplate>
					<DataTemplate x:DataType="set:InheritanceLevelItem">
						<TextBlock Text="{Binding DisplayName}"/>
					</DataTemplate>
				</ComboBox.ItemTemplate>

			</ComboBox>

		</Grid>

		<!-- Column headers -->
		<Grid ColumnDefinitions="*,Auto"
					IsEnabled="{Binding ToolSettings.EnableTools}">

			<TextBlock Grid.Column="0"
						   Text="{loc:Loc common.name}"
						   FontWeight="Bold"
						   Margin="5,0,0,0"/>

			<TextBlock Grid.Column="1"
						   Text="{loc:Loc common.policy}"
						   FontWeight="Bold"
						   Margin="8,0,8,0"/>
		</Grid>

		<ItemsControl ItemsSource="{Binding PolicyBehaviourItems}"
									IsEnabled="{Binding ToolSettings.EnableTools}">
			<ItemsControl.ItemTemplate>
				<DataTemplate x:DataType="sett:ToolBehaviourPolicyItem">
					<Border BorderBrush="{DynamicResource SecondaryAccentBrush}"
									BorderThickness="1"
									CornerRadius="4"
									Padding="8"
									Margin="0,0,0,8">
						<Grid RowDefinitions="Auto,Auto" VerticalAlignment="Center">

							<!-- Row 0: Icon + Name + ComboBox -->
							<Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">

								<ico:MaterialIcon Grid.Column="0"
												  Kind="{Binding Icon}"
												  Foreground="{Binding Color}"
												  Width="20" Height="20"
												  VerticalAlignment="Center"
												  Margin="0,0,8,0"/>

								<TextBlock Grid.Column="1"
										   Text="{Binding DisplayName.Value}"
										   FontWeight="Medium"
										   TextTrimming="CharacterEllipsis"
										   VerticalAlignment="Center"/>

								<ComboBox Grid.Column="2"
										  ItemsSource="{Binding PolicyModes}"
										  SelectedItem="{Binding PolicyMode, Mode=TwoWay}"
										  MinWidth="140"
										  Margin="8,0,0,0">
									<ComboBox.ItemTemplate>
										<DataTemplate x:DataType="sett:PolicyModeItem">
											<TextBlock Text="{Binding DisplayName}"/>
										</DataTemplate>
									</ComboBox.ItemTemplate>
								</ComboBox>
							</Grid>

							<!-- Row 1: Description -->
							<TextBlock Grid.Row="1"
									   Text="{Binding Description.RawValue}"
									   Opacity="0.6"
									   FontSize="12"
									   TextWrapping="Wrap"
									   Margin="28,4,0,0"
									   IsVisible="{Binding Description.RawValue, Converter={StaticResource StringNonEmptyToBooleanConverter}}"/>

						</Grid>
					</Border>
				</DataTemplate>
			</ItemsControl.ItemTemplate>
		</ItemsControl>

		<!-- Separator -->
		<Rectangle Height="1"
							 Fill="{DynamicResource DefaultForeground}"
							 Opacity="0.2"/>

		<!-- ============================================================ -->
		<!-- TOOLSET -->
		<!-- ============================================================ -->
		<Grid ColumnDefinitions="*,Auto">

			<TextBlock Grid.Column="0"
								 Text="{loc:Loc tool.settings}"
								 FontSize="{DynamicResource FontSizeL}"
								 FontWeight="Bold"
								 VerticalAlignment="Center"/>

			<ComboBox Grid.Column="1"
								ItemsSource="{x:Static set:InheritanceLevelItem.AllAgent}"
								SelectedItem="{Binding SelectedToolsetInheritance}"
								VerticalAlignment="Center"
								Margin="0,0,8,0"
								MinWidth="120">

				<ComboBox.ItemTemplate>
					<DataTemplate x:DataType="set:InheritanceLevelItem">
						<TextBlock Text="{Binding DisplayName}"/>
					</DataTemplate>
				</ComboBox.ItemTemplate>

			</ComboBox>

		</Grid>

		<CheckBox IsChecked="{Binding UseCustomToolset}"
							Content="{loc:Loc toolset.use_custom}"
							IsEnabled="{Binding ToolSettings.EnableTools}"/>

		<TextBlock Text="{loc:Loc toolset.use_custom.hint}"
							Opacity="0.6"
							TextWrapping="Wrap"
							IsEnabled="{Binding ToolSettings.EnableTools}"/>

		<!-- Shared toolset name editor -->
		<StackPanel Orientation="Horizontal"
								Spacing="4"
								IsVisible="{Binding UseCustomToolset, Converter={StaticResource InverseBooleanConverter}}"
								IsEnabled="{Binding ToolSettings.EnableTools}">

			<TextBlock Text="{loc:Loc toolset.shared}"
								 FontWeight="Bold"
								 VerticalAlignment="Center"
								 Margin="0,0,4,0"/>

			<StackPanel Orientation="Horizontal"
									Spacing="4"
									IsVisible="{Binding IsEditingId, Converter={StaticResource InverseBooleanConverter}}">

				<ComboBox MinWidth="150"
									VerticalAlignment="Center"
									SelectedItem="{Binding SelectedToolsetId}"
									ItemsSource="{Binding ToolsetIds}">

					<ComboBox.ItemTemplate>
						<DataTemplate x:DataType="appset:SettingsIdItemViewModel">
							<TextBlock Text="{Binding DisplayId}"/>
						</DataTemplate>
					</ComboBox.ItemTemplate>

				</ComboBox>

				<Button Command="{Binding CreateNewIdCommand}"
								Classes="IconButton"
								ToolTip.Tip="{loc:Loc toolset.create}">

					<ico:MaterialIcon Kind="Plus"/>
				</Button>

				<Button Command="{Binding RenameIdCommand}"
								Classes="IconButton"
								ToolTip.Tip="{loc:Loc toolset.rename}">

					<ico:MaterialIcon Kind="Edit"/>
				</Button>

				<Button Command="{Binding RemoveIdCommand}"
								Classes="IconButton"
								ToolTip.Tip="{loc:Loc toolset.remove}">

					<ico:MaterialIcon Kind="Remove"/>
				</Button>

			</StackPanel>

			<StackPanel Orientation="Horizontal"
									Spacing="4"
									IsVisible="{Binding IsEditingId}">

				<TextBox MinWidth="150"
								 VerticalAlignment="Center"
								 Text="{Binding NewId}"/>

				<Button Command="{Binding ConfirmEditIdCommand}"
								Classes="IconButton">

					<ico:MaterialIcon Kind="Check"/>
				</Button>

				<Button Command="{Binding CancelEditIdCommand}"
								Classes="IconButton">

					<ico:MaterialIcon Kind="Cancel"/>
				</Button>

			</StackPanel>

		</StackPanel>

		<!-- Separator -->
		<Rectangle Height="1"
							 Fill="{DynamicResource DefaultForeground}"
							 Opacity="0.2"/>

		<!-- Column headers for tool list -->
		<Grid Grid.IsSharedSizeScope="True">

			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="2"/>
				<ColumnDefinition Width="50"/>
				<ColumnDefinition Width="2"/>
				<ColumnDefinition Width="150"/>
				<ColumnDefinition Width="2"/>
				<ColumnDefinition Width="50"/>
			</Grid.ColumnDefinitions>

			<TextBlock Grid.Column="0"
								 Text="{loc:Loc common.name}"
								 Margin="5"
								 HorizontalAlignment="Left" VerticalAlignment="Center"
								 TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
								 FontWeight="Bold"/>

			<GridSplitter Grid.Column="1"
									  ResizeDirection="Columns"/>

			<TextBlock Grid.Column="2"
								 Text="{loc:Loc common.enable}"
								 Margin="5"
								 HorizontalAlignment="Left" VerticalAlignment="Center"
								 TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
								 FontWeight="Bold"/>

			<GridSplitter Grid.Column="3"
									  ResizeDirection="Columns"/>

			<TextBlock Grid.Column="4"
								 Text="{loc:Loc settings.tool.approval_level}"
								 Margin="5"
								 HorizontalAlignment="Left" VerticalAlignment="Center"
								 TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
								 FontWeight="Bold"/>

			<GridSplitter Grid.Column="5"
									  ResizeDirection="Columns"/>

			<TextBlock Grid.Column="6"
								 Text="{loc:Loc common.reset}"
								 Margin="5"
								 HorizontalAlignment="Left" VerticalAlignment="Center"
								 TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
								 FontWeight="Bold"/>

		</Grid>

		<!-- Tool list by categories -->
		<TreeView ItemsSource="{Binding ToolCategories}"
							IsEnabled="{Binding ToolSettings.EnableTools}"
							ScrollViewer.HorizontalScrollBarVisibility="Disabled"
							ScrollViewer.VerticalScrollBarVisibility="Auto">

			<TreeView.DataTemplates>

				<TreeDataTemplate DataType="local:ToolCategoryViewModel"
												  ItemsSource="{Binding Tools}">

					<Grid Margin="0,4">

						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="2"/>
							<ColumnDefinition Width="50"/>
							<ColumnDefinition Width="2"/>
							<ColumnDefinition Width="150"/>
							<ColumnDefinition Width="2"/>
							<ColumnDefinition Width="50"/>
						</Grid.ColumnDefinitions>

						<StackPanel Grid.Column="0"
												Orientation="Horizontal"
												VerticalAlignment="Center"
												Spacing="4"
												ClipToBounds="True">

							<TextBlock Text="{loc:Loc {Binding TitlePrefix}}"
												 Foreground="{Binding TitlePrefixForeground}"
												 IsVisible="{Binding TitlePrefix, Converter={StaticResource StringNonEmptyToBooleanConverter}}"
												 Opacity="0.7"/>

							<TextBlock Text="{loc:Loc {Binding Title}}"
											   FontWeight="Bold"/>

							<TextBlock Text="{Binding TitleSuffix}"
												 IsVisible="{Binding TitleSuffix, Converter={StaticResource StringNonEmptyToBooleanConverter}}"
												 Opacity="0.7"/>

						</StackPanel>

						<!-- Enabled -->
						<CheckBox Grid.Column="2"
											IsChecked="{Binding Enabled, Mode=TwoWay}"
											IsEnabled="{Binding CanToggleEnabled}"
											HorizontalAlignment="Center"/>

						<!-- Approval Level -->
						<ComboBox Grid.Column="4"
											SelectedItem="{Binding ApprovalLevel, Mode=TwoWay}"
											ItemsSource="{Binding ApprovalLevelList}"
											HorizontalAlignment="Stretch"
											Margin="2,0">
							<ComboBox.ItemTemplate>
								<DataTemplate>
									<TextBlock Text="{Binding DisplayName}"/>
								</DataTemplate>
							</ComboBox.ItemTemplate>
						</ComboBox>

						<!-- Reset -->
						<Button Grid.Column="6"
								Command="{Binding ResetCommand}"
								HorizontalAlignment="Center"
								Classes="IconButton">

							<ico:MaterialIcon Kind="Refresh"/>
						</Button>

					</Grid>

				</TreeDataTemplate>

				<DataTemplate DataType="local:ToolItemViewModel">

					<StackPanel>

						<Grid Margin="0,2">

							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="2"/>
								<ColumnDefinition Width="50"/>
								<ColumnDefinition Width="2"/>
								<ColumnDefinition Width="150"/>
								<ColumnDefinition Width="2"/>
								<ColumnDefinition Width="50"/>
							</Grid.ColumnDefinitions>

							<StackPanel Grid.Column="0"
													Orientation="Horizontal"
													VerticalAlignment="Center"
													Spacing="4"
													ClipToBounds="True">

								<TextBlock Text="{Binding TitlePrefix}"
													 Foreground="{Binding TitlePrefixForeground}"
													 IsVisible="{Binding TitlePrefix, Converter={StaticResource StringNonEmptyToBooleanConverter}}"
													 Opacity="0.7"/>

								<TextBlock Text="{loc:Loc {Binding Title}}"
												   FontWeight="Bold"
													 TextTrimming="CharacterEllipsis"
													 ToolTip.Tip="{loc:Loc {Binding Title}}"/>

								<ico:MaterialIcon Kind="Lock"
																	Width="14" Height="14"
																	Opacity="0.6"
																	VerticalAlignment="Center"
																	IsVisible="{Binding IsFixed}">
									<ToolTip.Tip>
										<StackPanel Orientation="Vertical" Spacing="4">
											<TextBlock Text="{loc:Loc tool.fixed}"
																 FontSize="{DynamicResource FontSizeM}"
																 FontWeight="SemiBold"/>
											<TextBlock Text="{loc:Loc tool.fixed.hint}"/>
										</StackPanel>
									</ToolTip.Tip>
								</ico:MaterialIcon>

							</StackPanel>

							<CheckBox Grid.Column="2"
												IsChecked="{Binding Enabled, Mode=TwoWay}"
												IsEnabled="{Binding IsFixed, Converter={StaticResource InverseBooleanConverter}}"
												HorizontalAlignment="Center"/>

							<ComboBox Grid.Column="4"
												SelectedItem="{Binding ApprovalLevel, Mode=TwoWay}"
												ItemsSource="{Binding ApprovalLevelList}"
												HorizontalAlignment="Stretch"
												Margin="2,0">
								<ComboBox.ItemTemplate>
									<DataTemplate>
										<TextBlock Text="{Binding DisplayName}"/>
									</DataTemplate>
								</ComboBox.ItemTemplate>
							</ComboBox>

							<Button Grid.Column="6"
											Command="{Binding ResetCommand}"
											HorizontalAlignment="Center"
											Classes="IconButton">
								<ico:MaterialIcon Kind="Refresh"/>
							</Button>

						</Grid>

						<StackPanel Orientation="Horizontal"
												Spacing="4">

							<TextBlock Text="{Binding Name}"
												 FontSize="11"
												 Opacity="0.4"
												 VerticalAlignment="Center"/>

							<ItemsControl ItemsSource="{Binding BehaviourFlags}"
														VerticalAlignment="Center">

								<ItemsControl.ItemsPanel>
									<ItemsPanelTemplate>
										<StackPanel Spacing="2" Orientation="Horizontal"/>
									</ItemsPanelTemplate>
								</ItemsControl.ItemsPanel>

								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<Panel>
											<ToolTip.Tip>
												<StackPanel Orientation="Vertical" Spacing="4">
													<TextBlock Text="{Binding DisplayName}"
																		 FontSize="{DynamicResource FontSizeM}"
																		 FontWeight="SemiBold"/>
													<TextBlock Text="{Binding Description}"/>
												</StackPanel>
											</ToolTip.Tip>
											<ico:MaterialIcon Kind="{Binding Icon}"
																				Foreground="{Binding Color}"
																				Background="Transparent"
																				Width="16" Height="16"/>
										</Panel>
									</DataTemplate>
								</ItemsControl.ItemTemplate>

							</ItemsControl>

						</StackPanel>

						<TextBlock Text="{Binding Description}"
											 Margin="0,2,0,8"
											 HorizontalAlignment="Left"
											 MaxWidth="500"
											 TextWrapping="Wrap"
											 Opacity="0.7"
											 FontSize="12"
											 IsVisible="{Binding Description}"/>

					</StackPanel>

				</DataTemplate>

			</TreeView.DataTemplates>

		</TreeView>

	</StackPanel>

</UserControl>
