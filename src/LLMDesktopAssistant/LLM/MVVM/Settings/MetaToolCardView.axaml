<UserControl xmlns="https://github.com/avaloniaui"
						 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
						 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
						 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
						 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
						 xmlns:local="using:LLMDesktopAssistant.LLM.MVVM.Settings"
						 xmlns:loc="using:LLMDesktopAssistant.Localization"
						 xmlns:ico="using:Material.Icons.Avalonia"
						 x:Class="LLMDesktopAssistant.LLM.MVVM.Settings.MetaToolCardView"
						 x:DataType="local:MetaToolCardViewModel">

	<UserControl.Styles>

		<Style Selector="Border.Chip">
			<Setter Property="CornerRadius" Value="8"/>
			<Setter Property="Padding" Value="6,2"/>
			<Setter Property="Margin" Value="0,0,4,2"/>
			<Setter Property="BorderBrush" Value="{DynamicResource SecondaryAccentBrush}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>

		<Style Selector="TextBlock.ChipText">
			<Setter Property="FontSize" Value="11"/>
			<Setter Property="Opacity" Value="0.8"/>
		</Style>

		<Style Selector="Border.ChipRed">
			<Setter Property="CornerRadius" Value="8"/>
			<Setter Property="Padding" Value="6,2"/>
			<Setter Property="Margin" Value="0,0,4,2"/>
			<Setter Property="BorderBrush" Value="#B71C1C"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>

	</UserControl.Styles>

	<Border BorderBrush="{DynamicResource SecondaryAccentBrush}"
					BorderThickness="1"
					CornerRadius="4"
					Padding="8">

		<StackPanel Orientation="Vertical" Spacing="4">

			<!-- ============================================================ -->
			<!-- Row 0: Language icon | Title | name | Broken indicator       -->
			<!-- ============================================================ -->
			<Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">

				<Border Grid.Column="0" Classes="Chip">
					<StackPanel Orientation="Horizontal" Spacing="3">
						<ico:MaterialIcon Kind="{Binding LanguageIcon}" Width="12" Height="12" VerticalAlignment="Center"/>
						<TextBlock Classes="ChipText" Text="{Binding LanguageName}"/>
					</StackPanel>
				</Border>

				<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="8,0,8,0" VerticalAlignment="Center">
					<TextBlock Text="{Binding Title}"
									   FontWeight="Bold"
									   VerticalAlignment="Center"
									   TextTrimming="CharacterEllipsis"/>
					<TextBlock Text="{Binding Name}"
									   FontSize="11"
									   Opacity="0.6"
									   VerticalAlignment="Center"
									   TextTrimming="CharacterEllipsis"/>
				</StackPanel>

				<Border Grid.Column="2" Classes="ChipRed"
								IsVisible="{Binding IsBroken}"
								ToolTip.Tip="{Binding Error}">
					<StackPanel Orientation="Horizontal" Spacing="3">
						<ico:MaterialIcon Kind="AlertCircle" Width="12" Height="12" Foreground="#FF5252" VerticalAlignment="Center"/>
						<TextBlock Classes="ChipText" Text="{loc:Loc settings.tools.meta_tools.broken}"/>
					</StackPanel>
				</Border>

			</Grid>

			<!-- ============================================================ -->
			<!-- Row 1: Description                                            -->
			<!-- ============================================================ -->
			<TextBlock Text="{Binding Description}"
							   TextWrapping="Wrap"
							   Opacity="0.8"
							   IsVisible="{Binding Description, Converter={StaticResource StringNonEmptyToBooleanConverter}}"/>

			<!-- ============================================================ -->
			<!-- Row 2: Chips: scope, category, approval level, behaviours    -->
			<!-- ============================================================ -->
			<WrapPanel>

				<Border Classes="Chip" IsVisible="{Binding Category, Converter={StaticResource StringNonEmptyToBooleanConverter}}">
					<StackPanel Orientation="Horizontal" Spacing="3">
						<ico:MaterialIcon Kind="TagOutline" Width="12" Height="12" VerticalAlignment="Center"/>
						<TextBlock Classes="ChipText" Text="{Binding Category}"/>
					</StackPanel>
				</Border>

				<Border Classes="Chip" ToolTip.Tip="{loc:Loc settings.tools.meta_tools.approval}"
								IsVisible="{Binding ApprovalLevelName}">
					<StackPanel Orientation="Horizontal" Spacing="3">
						<ico:MaterialIcon Kind="ShieldCheck" Width="12" Height="12" VerticalAlignment="Center"/>
						<TextBlock Classes="ChipText" Text="{Binding ApprovalLevelName}"/>
					</StackPanel>
				</Border>

				<!-- Behaviour Chip -->
				<Border Classes="Chip">
					<ItemsControl ItemsSource="{Binding BehaviourFlags}">
						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<WrapPanel/>
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>
						<ItemsControl.ItemTemplate>
							<DataTemplate x:DataType="local:ToolBehaviourFlagInfo">
								<ico:MaterialIcon Kind="{Binding Icon}" Width="12" Height="12" VerticalAlignment="Center" Foreground="{Binding Color}">
									<ToolTip.Tip>
										<StackPanel Orientation="Vertical" Spacing="4">
											<TextBlock Text="{loc:Loc {Binding DisplayName}}"
																 FontSize="{DynamicResource FontSizeM}"
																 FontWeight="SemiBold"/>
											<TextBlock Text="{loc:Loc {Binding Description}}"/>
										</StackPanel>
									</ToolTip.Tip>
								</ico:MaterialIcon>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</Border>

				<!-- Source indicator -->
				<StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center" Margin="4,0,0,0">
					<ico:MaterialIcon Kind="{Binding SourceIcon}" Width="12" Height="12" Opacity="0.5" VerticalAlignment="Center"/>
					<TextBlock Text="{Binding SourceName}" Opacity="0.5" FontSize="11" VerticalAlignment="Center"/>
				</StackPanel>

			</WrapPanel>

			<!-- ============================================================ -->
			<!-- Row 3: Diagnostic Chips + error                               -->
			<!-- ============================================================ -->
			<StackPanel Orientation="Horizontal" Spacing="4"
									IsVisible="{Binding HasDiagnostics}">
				<ItemsControl ItemsSource="{Binding DiagnosticFlags}">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<WrapPanel/>
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>
					<ItemsControl.ItemTemplate>
						<DataTemplate x:DataType="local:MetaToolDiagnosticFlagInfo">
							<Border Classes="Chip" ToolTip.Tip="{Binding DisplayName}">
								<StackPanel Orientation="Horizontal" Spacing="3">
									<ico:MaterialIcon Kind="{Binding Icon}" Width="12" Height="12" VerticalAlignment="Center" Foreground="{Binding Color}"/>
									<TextBlock Classes="ChipText" Foreground="{Binding Color}" Text="{Binding DisplayName}"/>
								</StackPanel>
							</Border>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</StackPanel>

			<!-- ============================================================ -->
			<!-- Row 4: Path + actions                                          -->
			<!-- ============================================================ -->
			<Grid ColumnDefinitions="*,Auto">

				<StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
					<ico:MaterialIcon Kind="FileOutline" Width="12" Height="12" Opacity="0.5" VerticalAlignment="Center"/>
					<TextBlock Text="{Binding FilePath}"
									   FontSize="11"
									   Opacity="0.6"
									   VerticalAlignment="Center"
									   TextTrimming="CharacterEllipsis"/>
				</StackPanel>

				<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">

					<Button Command="{Binding EditCommand}"
									ToolTip.Tip="{loc:Loc settings.tools.meta_tools.edit}"
									Padding="4">
						<ico:MaterialIcon Kind="Pencil" Width="14" Height="14"/>
					</Button>

					<Button Command="{Binding OpenFileCommand}"
									ToolTip.Tip="{loc:Loc settings.tools.meta_tools.open_file}"
									Padding="4">
						<ico:MaterialIcon Kind="OpenInNew" Width="14" Height="14"/>
					</Button>

					<Button Command="{Binding ShowInExplorerCommand}"
									ToolTip.Tip="{loc:Loc settings.tools.meta_tools.show_in_explorer}"
									Padding="4">
						<ico:MaterialIcon Kind="FolderOpen" Width="14" Height="14"/>
					</Button>

					<Button Command="{Binding RenameCommand}"
									ToolTip.Tip="{loc:Loc settings.tools.meta_tools.rename.title}"
									Padding="4">
						<ico:MaterialIcon Kind="Rename" Width="14" Height="14"/>
					</Button>

					<Button Command="{Binding DuplicateCommand}"
									ToolTip.Tip="{loc:Loc settings.tools.meta_tools.duplicate.title}"
									Padding="4">
						<ico:MaterialIcon Kind="ContentCopy" Width="14" Height="14"/>
					</Button>

					<Button Command="{Binding DeleteCommand}"
									ToolTip.Tip="{loc:Loc settings.tools.meta_tools.delete.title}"
									Padding="4">
						<ico:MaterialIcon Kind="Delete" Width="14" Height="14"/>
					</Button>

					<Button Command="{Binding ToggleDetailsCommand}"
									ToolTip.Tip="{loc:Loc settings.tools.meta_tools.details}"
									Padding="4">
						<ico:MaterialIcon Kind="CodeJson" Width="14" Height="14"/>
					</Button>

				</StackPanel>

			</Grid>

			<!-- ============================================================ -->
			<!-- Row 5: Details (argument schema)                              -->
			<!-- ============================================================ -->
			<Border Background="#11000000"
							CornerRadius="4"
							Padding="8"
							IsVisible="{Binding IsDetailsVisible}">
				<TextBlock Text="{Binding ArgumentSchemaText}"
								   FontFamily="Consolas,Monospace"
								   FontSize="11"
								   TextWrapping="Wrap"/>
			</Border>

		</StackPanel>

	</Border>
</UserControl>
