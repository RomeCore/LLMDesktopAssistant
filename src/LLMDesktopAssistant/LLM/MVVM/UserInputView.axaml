<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:local="using:LLMDesktopAssistant.LLM.MVVM"
			 xmlns:loc="using:LLMDesktopAssistant.Localization"
			 xmlns:ctrl="using:LLMDesktopAssistant.Controls"
			 xmlns:sett="using:LLMDesktopAssistant.Settings"
			 xmlns:ico="using:Material.Icons.Avalonia"
			 mc:Ignorable="d" d:DesignWidth="800"
			 x:Class="LLMDesktopAssistant.LLM.MVVM.UserInputView"
			 x:DataType="local:UserInputViewModel">
	
	<Grid RowDefinitions="Auto,*,Auto"
		  Background="Transparent">
		
		<ItemsControl Grid.Row="0"
					  ItemsSource="{Binding Attachments}">
			<ItemsControl.ItemsPanel>
				<ItemsPanelTemplate>
					<WrapPanel Orientation="Horizontal"/>
				</ItemsPanelTemplate>
			</ItemsControl.ItemsPanel>
		</ItemsControl>

		<TextBox Grid.Row="1"
				 x:Name="InputTextBox"
				 Text="{Binding Text, Mode=TwoWay}"
				 AcceptsReturn="True"
				 TextWrapping="Wrap"
				 MaxHeight="150"
				 Margin="0,4"
				 FontSize="16"
				 VerticalAlignment="Center"
				 PlaceholderText="{loc:Loc chat.input.hint}"
				 ScrollViewer.VerticalScrollBarVisibility="Auto"/>

		<DockPanel Grid.Row="2" Margin="0,6,0,0" LastChildFill="True">

			<StackPanel DockPanel.Dock="Left"
						Orientation="Horizontal"
						HorizontalAlignment="Left"
						Spacing="5">

				<ComboBox SelectedItem="{Binding SelectedSettingsId}" ItemsSource="{Binding SettingsIds}">
					<ComboBox.ItemTemplate>
						<DataTemplate x:DataType="sett:SettingsIdItemViewModel">
							<TextBlock Text="{Binding DisplayId}"/>
						</DataTemplate>
					</ComboBox.ItemTemplate>
				</ComboBox>
				
				<!-- Settings -->
				<Button Classes="IconButton"
								Command="{Binding OpenSettingsCommand}"
								ToolTip.Tip="{loc:Loc common.settings}">

					<ico:MaterialIcon Kind="Cog"/>
				</Button>

				<!-- Model selector -->
				<ctrl:ModelSelectorControl SelectedModel="{Binding ChatModel, Mode=TwoWay}"/>

				<!-- Attach -->
				<Button Classes="IconButton"
								Command="{Binding OpenAttachmentsManagerCommand}"
								ToolTip.Tip="{loc:Loc chat.input.attach_file.hint}">

					<ico:MaterialIcon Kind="Paperclip"/>
				</Button>

				<!-- Blazor Web UI Host -->
				<Button Classes="IconButton"
								Command="{Binding OpenBlazorWebUICommand}"
								ToolTip.Tip="{loc:Loc webui.host.title}">

					<ico:MaterialIcon Kind="Web"/>
				</Button>

			</StackPanel>

			<!-- Right side -->
			<StackPanel DockPanel.Dock="Right"
									Orientation="Horizontal"
									HorizontalAlignment="Right"
									Spacing="5">
				
				<!-- Active user selector -->
				<ComboBox ItemsSource="{Binding Users}"
								  SelectedItem="{Binding SelectedUser, Mode=TwoWay}"
								  MinWidth="110"
								  MaxWidth="250"
								  VerticalAlignment="Center"
								  IsVisible="{Binding HasMultipleUsers}"
								  ToolTip.Tip="{loc:Loc chat.user.active.hint}">

					<ComboBox.ItemTemplate>
						<DataTemplate>
							<StackPanel Orientation="Horizontal" Spacing="6">
								<ico:MaterialIcon Kind="AccountCircle"
																  Width="14" Height="14"
																  VerticalAlignment="Center"
																  Opacity="0.7"/>
								<TextBlock Text="{Binding Name}"
												   FontWeight="Medium"
												   VerticalAlignment="Center"
												   TextTrimming="CharacterEllipsis"/>
							</StackPanel>
						</DataTemplate>
					</ComboBox.ItemTemplate>

				</ComboBox>

				<!-- Visibility selector -->
				<ComboBox ItemsSource="{Binding Visibilities}"
						  SelectedItem="{Binding SelectedVisibility}"
						  MinWidth="120"
						  Margin="4,0"
						  ToolTip.Tip="{loc:Loc chat.visibility.hint}">

					<ComboBox.ItemTemplate>
						<DataTemplate>
							<StackPanel Orientation="Horizontal" Spacing="6">
								<ico:MaterialIcon Kind="{Binding Icon}"
												  Width="14" Height="14"
												  VerticalAlignment="Center"
												  Opacity="0.7"/>
								<TextBlock Text="{loc:Loc {Binding Title}}"
										   VerticalAlignment="Center"/>
							</StackPanel>
						</DataTemplate>
					</ComboBox.ItemTemplate>
				</ComboBox>

				<!-- Cancel edit -->
				<Button Classes="IconButton"
						Command="{Binding CancelEditCommand}"
						ToolTip.Tip="{loc:Loc chat.input.cancel_edit.hint}">

					<ico:MaterialIcon Kind="EditOff"/>
				</Button>
				
				<!-- Send -->
				<Button Classes="IconButton"
						Command="{Binding SendMessageCommand}"
						ToolTip.Tip="{loc:Loc chat.input.send_button.hint}">

					<ico:MaterialIcon Kind="SendClock"/>
				</Button>

				<!-- Send with generation -->
				<Button Classes="IconButton"
						Command="{Binding SendGenerateMessageCommand}"
						IsVisible="{Binding IsGenerating, Converter={StaticResource InverseBooleanConverter}}"
						ToolTip.Tip="{loc:Loc chat.input.send_button.hint}">

					<ico:MaterialIcon Kind="Send"/>
				</Button>

				<!-- Stop -->
				<Button Classes="IconButton"
						Command="{Binding CancelGenerationCommand}"
						IsVisible="{Binding IsGenerating}"
						ToolTip.Tip="{loc:Loc chat.input.stop_button.hint}">

					<ico:MaterialIcon Kind="Stop"/>
				</Button>

			</StackPanel>

		</DockPanel>
		
		<Border x:Name="DropOverlay"
				Grid.RowSpan="3"
				Background="#2000BCD4"
				BorderBrush="#6000BCD4"
				BorderThickness="3"
				CornerRadius="8"
				IsVisible="False"
				IsHitTestVisible="False">
			
			<TextBlock Text="{loc:Loc attachment.drop_files_here}"
					   HorizontalAlignment="Center"
					   VerticalAlignment="Center"
					   FontSize="18"
					   Foreground="#FF00BCD4"/>
		</Border>

	</Grid>

</UserControl>