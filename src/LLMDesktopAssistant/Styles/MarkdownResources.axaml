<ResourceDictionary xmlns="https://github.com/avaloniaui"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<x:Double x:Key="FontSizeS">14</x:Double>
	<x:Double x:Key="FontSizeM">17</x:Double>
	<x:Double x:Key="FontSizeL">20</x:Double>
	<x:Double x:Key="FontSizeXl">22</x:Double>
	<x:Double x:Key="FontSize2Xl">26</x:Double>
	<x:Double x:Key="FontSize3Xl">30</x:Double>


	<!-- GitHub-style alert colors -->
	<Color x:Key="AlertNoteColor">#4A9EFF</Color>
	<Color x:Key="AlertTipColor">#2ECC71</Color>
	<Color x:Key="AlertImportantColor">#6C5CE7</Color>
	<Color x:Key="AlertWarningColor">#D4A017</Color>
	<Color x:Key="AlertCautionColor">#FF4444</Color>

	<SolidColorBrush x:Key="AlertNoteBackgroundBrush" Color="#1A4A9EFF"/>
	<SolidColorBrush x:Key="AlertNoteBorderBrush" Color="#664A9EFF"/>
	<SolidColorBrush x:Key="AlertTipBackgroundBrush" Color="#1A2ECC71"/>
	<SolidColorBrush x:Key="AlertTipBorderBrush" Color="#662ECC71"/>
	<SolidColorBrush x:Key="AlertImportantBackgroundBrush" Color="#1A6C5CE7"/>
	<SolidColorBrush x:Key="AlertImportantBorderBrush" Color="#666C5CE7"/>
	<SolidColorBrush x:Key="AlertWarningBackgroundBrush" Color="#1AD4A017"/>
	<SolidColorBrush x:Key="AlertWarningBorderBrush" Color="#66D4A017"/>
	<SolidColorBrush x:Key="AlertCautionBackgroundBrush" Color="#1AFF4444"/>
	<SolidColorBrush x:Key="AlertCautionBorderBrush" Color="#66FF4444"/>

</ResourceDictionary>