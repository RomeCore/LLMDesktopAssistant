<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="300"
			 xmlns:local="using:LLMDesktopAssistant.Prompting.Parameterization.MVVM"
			 xmlns:ico="using:Material.Icons.Avalonia"
			 x:Class="LLMDesktopAssistant.Prompting.Parameterization.MVVM.ParameterSchemaListView"
			 x:DataType="local:ParameterSchemaListViewModel">

	<StackPanel Classes="PromptParameterListContainer">

		<ItemsControl ItemsSource="{Binding Items}" Classes="PromptParameterList">
			<ItemsControl.ItemTemplate>
				<DataTemplate x:DataType="local:ParameterSchemaListItemViewModel">
					<DockPanel Classes="PromptParameterListItem">
						<Button DockPanel.Dock="Right"
								Classes="PromptParameterRemoveButton IconButton MiniIconButton"
								Command="{Binding $parent[UserControl].((local:ParameterSchemaListViewModel)DataContext).RemoveCommand}"
								CommandParameter="{Binding}"
								VerticalAlignment="Top"
								ToolTip.Tip="Remove">
							<ico:MaterialIcon Kind="Delete" Classes="MiniIcon"/>
						</Button>
						<ContentControl Content="{Binding Control}"/>
					</DockPanel>
				</DataTemplate>
			</ItemsControl.ItemTemplate>
		</ItemsControl>

		<Button Classes="PromptParameterAddButton"
				Command="{Binding AddCommand}"
				HorizontalAlignment="Left">
			<StackPanel Orientation="Horizontal" Spacing="4">
				<ico:MaterialIcon Kind="Plus" Classes="SmallIcon"/>
				<TextBlock Text="Add"/>
			</StackPanel>
		</Button>

	</StackPanel>

</UserControl>
