<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="300"
			 xmlns:local="using:LLMDesktopAssistant.Prompting.Parameterization.MVVM"
			 x:Class="LLMDesktopAssistant.Prompting.Parameterization.MVVM.ParameterSchemaObjectView"
			 x:DataType="local:ParameterSchemaObjectViewModel">

	<ItemsControl ItemsSource="{Binding Items}" Classes="PromptParameterObject">
		<ItemsControl.ItemTemplate>
			<DataTemplate x:DataType="local:ParameterSchemaObjectItemViewModel">
				<StackPanel Classes="PromptParameterPropertyContainer">
					<TextBlock Text="{Binding Key}" Classes="PromptParameterPropertyTitle"/>
					<ContentControl Content="{Binding Control}"/>
				</StackPanel>
			</DataTemplate>
		</ItemsControl.ItemTemplate>
	</ItemsControl>

</UserControl>
