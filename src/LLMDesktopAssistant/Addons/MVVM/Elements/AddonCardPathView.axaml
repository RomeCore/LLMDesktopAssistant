<UserControl xmlns="https://github.com/avaloniaui"
						 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
						 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
						 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
						 mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="20"
						 xmlns:vm="using:LLMDesktopAssistant.Addons.MVVM.Elements"
						 x:Class="LLMDesktopAssistant.Addons.MVVM.Elements.AddonCardPathView"
						 x:DataType="vm:AddonCardPathViewModel">

	<TextBlock Text="{Binding Path}"
						 ToolTip.Tip="{Binding Path}"
						 Opacity="0.5"
						 FontSize="11"
						 TextTrimming="CharacterEllipsis"
						 VerticalAlignment="Center"/>

</UserControl>
