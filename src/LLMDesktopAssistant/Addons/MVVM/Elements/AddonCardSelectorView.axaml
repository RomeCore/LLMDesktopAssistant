<UserControl xmlns="https://github.com/avaloniaui"
						 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
						 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
						 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
						 mc:Ignorable="d" d:DesignWidth="140" d:DesignHeight="30"
						 xmlns:vm="using:LLMDesktopAssistant.Addons.MVVM.Elements"
						 xmlns:loc="using:LLMDesktopAssistant.Localization"
						 x:Class="LLMDesktopAssistant.Addons.MVVM.Elements.AddonCardSelectorView"
						 x:DataType="vm:AddonCardSelectorViewModel">

	<ComboBox MinWidth="110"
						FontSize="12"
						VerticalAlignment="Center"
						ItemsSource="{Binding Options}"
						SelectedItem="{Binding SelectedOption, Mode=TwoWay}"
						IsEnabled="{Binding CanEdit}"
						PlaceholderText="{loc:Loc {Binding Placeholder}}">

		<ComboBox.ItemTemplate>
			<DataTemplate x:DataType="vm:IAddonCardSelectorOption">
				<TextBlock Text="{loc:Loc {Binding DisplayName}}"
									 VerticalAlignment="Center"/>
			</DataTemplate>
		</ComboBox.ItemTemplate>

	</ComboBox>

</UserControl>
