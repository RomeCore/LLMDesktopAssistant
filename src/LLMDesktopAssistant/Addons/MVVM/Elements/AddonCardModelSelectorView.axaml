<UserControl xmlns="https://github.com/avaloniaui"
						 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
						 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
						 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
						 mc:Ignorable="d" d:DesignWidth="160" d:DesignHeight="30"
						 xmlns:vm="using:LLMDesktopAssistant.Addons.MVVM.Elements"
						 xmlns:ctl="using:LLMDesktopAssistant.Controls"
						 x:Class="LLMDesktopAssistant.Addons.MVVM.Elements.AddonCardModelSelectorView"
						 x:DataType="vm:AddonCardModelSelectorViewModel">

	<ctl:ModelSelectorControl SelectedModel="{Binding SelectedModel, Mode=TwoWay}"
														IsEnabled="{Binding CanEdit}"
														VerticalAlignment="Center"/>

</UserControl>
